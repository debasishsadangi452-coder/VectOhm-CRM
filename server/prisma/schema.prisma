  name           String
  contactNumber  String?
  website        String?
  industry       String?
  status         String   @default("Active")
  category       String?
  businessUnit   String?
  displayOnJob   Boolean  @default(true)
  hasBadge       Boolean  @default(false)
  primaryOwnerId String?
  primaryOwner   User?    @relation("ClientPrimaryOwner", fields: [primaryOwnerId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User     @relation("ClientCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A staffing sub-vendor/supplier for the Ceipal-style recruitment CRM.
model Vendor {
  id            String   @id @default(uuid())
  name          String
  website       String?
  contactNumber String?
  state         String?
  country       String?
  ownership     String?
  businessUnit  String?
  // Quick-create header form fields (src/components/ceipal/ceipal-header.tsx)
