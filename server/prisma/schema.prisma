  createdBy      User      @relation("LeadCreatedBy", fields: [createdById], references: [id])
  gclid          String?
  wbraid         String?
  gbraid         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  landingPage    String?
