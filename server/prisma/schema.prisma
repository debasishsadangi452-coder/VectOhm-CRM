  email         String?
  category      String?
  createdById   String
  createdBy     User     @relation("VendorCreatedBy", fields: [createdById], references: [id])
  modifiedById  String?
  modifiedBy    User?    @relation("VendorModifiedBy", fields: [modifiedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A recruitment lead (a prospective client/req, not yet a Job Posting) for
// the Ceipal-style recruitment CRM -- distinct from Company/Contact's sales
// pipeline, which is a different funnel with its own LeadSource enum.
model Lead {
  id             String    @id @default(uuid())
  name           String
  // The organization this lead is at, distinct from `name` (the contact
  // person) -- src/components/ceipal/ceipal-header.tsx's quick-create form.
  company        String?
  status         String    @default("New")
  source         String?
  website        String?
  contactNumber  String?
  email          String?
  notes          String?
  businessUnit   String?
  zipCode        String?
