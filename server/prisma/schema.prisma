// Singleton row (fixed id, always upserted/read by that same id) holding
// company-wide, Admin-editable content for parts of the UI that would
// otherwise be hardcoded copy -- starting with the Dashboard hero section.
model AppSettings {
  id          String   @id @default("app-settings")
  heroTagline String?
  updatedAt   DateTime @updatedAt
}

enum GithubAccountType {
  USER
  ORG
}

// Singleton row holding the company's GitHub connection. The token is stored
// AES-256-GCM encrypted (see common/utils/token-crypto.ts) -- the encryption
// key lives only in APP_ENCRYPTION_KEY, never here. Deliberately its OWN model
// rather than a field on AppSettings, because AppSettings has a public read
// endpoint and this token must never be exposed. Only status (login/type) is
// ever returned to clients; the token stays server-side.
model GithubConnection {
  id               String            @id @default("github-connection")
  accountType      GithubAccountType @default(ORG)
  accountLogin     String
  encryptedToken   String
  tokenIv          String
  tokenAuthTag     String
  connectedByEmail String?
  updatedAt        DateTime          @updatedAt
}

// Singleton row holding the company's Apollo.io API key, same
// encrypted-at-rest shape as GithubConnection. Only status (whether it's
// connected, who connected it) is ever returned to clients; the key stays
// server-side and is decrypted per-call in ApolloService.
model ApolloConnection {
  id              String   @id @default("apollo-connection")
  encryptedApiKey String
  apiKeyIv        String
  apiKeyAuthTag   String
  connectedById   String?
  connectedBy     User?    @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A Sales user's own mailbox, connected via SMTP so Bulk Email blasts and
// Sequence drip steps send from their real address instead of a shared
// company sender -- recipients see (and can reply to) the actual person,
// not a noreply@ address. Same encrypted-at-rest shape as ApolloConnection
// (see common/utils/token-crypto.ts). One row per user; the bulk-email and
// sequence engines look this up by the campaign/enrollment owner at send
// time and refuse to send if it's missing or unverified (see
// EmailConnectionsService.requireVerifiedTransport).
enum EmailConnectionType {
  SMTP
  OAUTH_GOOGLE
  OAUTH_MICROSOFT
  OAUTH_ZOHO
}

model UserEmailConnection {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionType EmailConnectionType @default(SMTP)
  label          String?
  isDefault      Boolean             @default(true)

  // SMTP fields -- only populated when connectionType = SMTP. Optional so
  // an OAuth-connected row doesn't need dummy values here.
  smtpHost          String?
  smtpPort          Int?
  smtpSecure        Boolean?
  smtpUsername      String?
  encryptedPassword String?
  passwordIv        String?
  passwordAuthTag   String?

  // OAuth fields -- only populated when connectionType = OAUTH_GOOGLE or
  // OAUTH_MICROSOFT. Refresh token encrypted the same way as the SMTP
  // password (see common/utils/token-crypto.ts).
  oauthAccessToken      String?
  encryptedRefreshToken String?
  refreshTokenIv        String?
  refreshTokenAuthTag   String?
  oauthExpiresAt        DateTime?
  oauthScope            String?
  // The actual mailbox address returned by the provider -- may differ from
  // User.email (a personal Gmail vs. a work login, for instance).
  providerAccountEmail  String?

  // Sync bookkeeping for EmailSyncEngineService (OAuth connections only).
  // syncCursor is opaque and provider-specific: Gmail's historyId, or
  // Microsoft Graph's @odata.deltaLink.
  lastSyncedAt DateTime?
  syncCursor   String?

  fromName       String?
  fromEmail      String?
  verified       Boolean   @default(false)
  lastVerifiedAt DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  syncedEmails SyncedEmail[]
  campaigns    BulkEmailCampaign[]

  @@index([userId])
}

// =========================================================================
// GOOGLE ADS & GOOGLE ANALYTICS INTEGRATION MODELS
// =========================================================================

model GoogleAdsConnection {
  id                    String    @id @default("google-ads-connection")
  customerAccountId     String    @default("")
