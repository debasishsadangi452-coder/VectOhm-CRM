generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  MANAGER
  EMPLOYEE
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id             String  @id @default(uuid())
  email          String  @unique
  passwordHash   String
  firstName      String
  lastName       String
  avatarUrl      String?
  githubUsername String? @unique
  isActive       Boolean @default(true)
  // false = the server refuses this person's screen recordings (the desktop agent then stops recording).
  screenRecordingEnabled Boolean @default(true)
  // false (default) = this person cannot sign out of the CRM (web or agent) so screen recording never stops;
  // only an Admin can grant it. ADMIN accounts can always sign out.
  canSignOut     Boolean @default(false)
  // Which modules (sidebar pages and the APIs behind them) this person can use. false = the default
  // for their role and department; true = exactly the keys in `modules` (see common/utils/modules.ts).
  modulesCustomized Boolean @default(false)
  modules        String[] @default([])
  roleId         String
  role           Role    @relation(fields: [roleId], references: [id])

  departmentId  String?
  department    Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  // Current monthly $ target for this individual, same pragmatic single-value
  // style as Department.monthlyTarget.
  monthlyTarget Int?
  // Working hours, "HH:MM" 24h in the company timezone (see work-policy.ts).
  // Set by Admin/HR when creating the account; drives late / early-leave checks.
  shiftStart    String      @default("10:00")
  shiftEnd      String      @default("19:00")
  managerId     String?
  manager       User?       @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports       User[]      @relation("UserManager")

  headOfDepartments Department[] @relation("DepartmentHead")

  refreshTokens             RefreshToken[]
  signOutRequests           SignOutRequest[]      @relation("SignOutRequestUser")
  signOutDecisions          SignOutRequest[]      @relation("SignOutRequestDecider")
  adjustmentRequests        AttendanceAdjustmentRequest[] @relation("AdjustmentRequestUser")
  adjustmentDecisions       AttendanceAdjustmentRequest[] @relation("AdjustmentRequestDecider")
  lateStartRequests         LateStartRequest[]    @relation("LateStartRequestUser")
  lateStartDecisions        LateStartRequest[]    @relation("LateStartRequestDecider")
  passwordResetTokens       PasswordResetToken[]
  assignedTasks             Task[]                @relation("TaskAssignee")
  createdTasks              Task[]                @relation("TaskCreator")
  ownedProjects             Project[]             @relation("ProjectOwner")
  ownedDeals                Deal[]                @relation("DealOwner")
  loggedActivities          Activity[]            @relation("ActivityCreator")
  engagementEvents          EngagementEvent[]     @relation("EngagementEventOwner")
  followUpTasks             FollowUpTask[]        @relation("FollowUpTaskAssignee")
  recruiterTasks            RecruiterTaskQueue[]
  taskAssignees             TaskAssignee[]        @relation("TaskAssigneeUser")
  testedTasks               Task[]                @relation("TaskTester")
  taskActivityLogs          TaskActivityLog[]     @relation("TaskActivityAuthor")
  reportedBugs              Bug[]                 @relation("BugReporter")
  assignedBugs              Bug[]                 @relation("BugAssignee")
  bugComments               BugComment[]          @relation("BugCommentAuthor")
  bugActivityLogs           BugActivityLog[]      @relation("BugActivityAuthor")
  submittedBugFixes         Bug[]                 @relation("BugFixSubmitter")
  reviewedBugs              Bug[]                 @relation("BugReviewer")
  sentMessages              ChatMessage[]         @relation("MessageSender")
  dmChannels1               ChatChannel[]         @relation("dmUser1")
  dmChannels2               ChatChannel[]         @relation("dmUser2")
  kbArticles                KBArticle[]           @relation("KBArticleAuthor")
  gitCommits                GitCommit[]           @relation("CommitAuthor")
  seoContentBriefs          SeoContentBrief[]     @relation("BriefAssignee")
  reviewedBriefs            SeoContentBrief[]     @relation("BriefReviewer")
  loggedBacklinks           SeoBacklink[]         @relation("BacklinkLogger")
  verifiedBacklinks         SeoBacklink[]         @relation("BacklinkVerifier")
  memberOfProjects          Project[]             @relation("ProjectMembers")
  ownedJobPostings          JobPosting[]          @relation("JobPostingOwner")
  ownedCandidates           Candidate[]           @relation("CandidateOwner")
  interviewsConducted       Interview[]           @relation("InterviewInterviewer")
  interviewsCreated         Interview[]           @relation("InterviewCreator")
  offersCreated             Offer[]               @relation("OfferCreator")
  ownedClients              Client[]              @relation("ClientPrimaryOwner")
  createdClients            Client[]              @relation("ClientCreatedBy")
  createdVendors            Vendor[]              @relation("VendorCreatedBy")
  modifiedVendors           Vendor[]              @relation("VendorModifiedBy")
  createdLeads              Lead[]                @relation("LeadCreatedBy")
  createdEboardings         Eboarding[]           @relation("EboardingCreatedBy")
  createdJobTasks           JobTask[]             @relation("JobTaskCreatedBy")
  createdJobActivities      JobActivity[]         @relation("JobActivityCreatedBy")
  createdJobEmailMerges     JobEmailMerge[]       @relation("JobEmailMergeCreatedBy")
  createdJobSubmissions     JobSubmission[]       @relation("JobSubmissionCreatedBy")
  createdJobNotes           JobNote[]             @relation("JobNoteCreatedBy")
  createdJobDocuments       JobDocument[]         @relation("JobDocumentCreatedBy")
  leaveRequests             LeaveRequest[]        @relation("UserLeaveRequests")
  reviewedLeaves            LeaveRequest[]        @relation("LeaveReviewer")
  notifications             Notification[]        @relation("UserNotifications")
  workSessions              WorkSession[]         @relation("UserWorkSessions")
  idleEvents                IdleEvent[]           @relation("UserIdleEvents")
  absences                  AbsenceRecord[]       @relation("UserAbsences")
  taskUpdates               TaskUpdate[]          @relation("TaskUpdateAuthor")
  timeLogs                  TimeLog[]             @relation("TaskTimeLogAuthor")
  timeLogsReviewed          TimeLog[]             @relation("TimeLogReviewer")
  apolloConnections         ApolloConnection[]
  emailTemplates            EmailTemplate[]
  createdSequences          Sequence[]
  sequenceEnrollments       SequenceEnrollment[]
  bulkEmailCampaigns        BulkEmailCampaign[]
  contactImportBatches      ContactImportBatch[]
  emailConnections          UserEmailConnection[]
  linkedinConnection        UserLinkedInConnection?
  loginEvents               LoginEvent[]          @relation("UserLoginEvents")
  termsAcceptances          TermsAcceptance[]     @relation("UserTermsAcceptances")
  screenCaptures            ScreenCapture[]       @relation("UserScreenCaptures")
  screenRecordings          ScreenRecording[]     @relation("UserScreenRecordings")
  activityPings             ActivityPing[]        @relation("UserActivityPings")
  growthSignalReviews       CompanyGrowthSignal[] @relation("GrowthSignalReviewer")
  chatChannelReads          ChatChannelRead[]
  chatMemberships           ChatChannelMember[]
  loginPhotos               LoginPhoto[]          @relation("UserLoginPhotos")
  trainingVideos            TrainingVideo[]       @relation("TrainingVideoUploader")
  dealDocuments             DealDocument[]        @relation("DealDocumentUploader")
  signatureImages           EmailSignatureImage[] @relation("SignatureImageOwner")
  calls                     Call[]                @relation("CallAgent")
  connectedJustCall         JustCallConnection[]
  connectedCloudTalk        CloudTalkConnection[]
  connectedJobBoards        JobBoardConnection[]
  connectedAggregator       JobDistributionAggregatorConnection[]
  connectedGoogleAds        GoogleAdsConnection[]
  connectedGoogleAnalytics  GoogleAnalyticsConnection[]
  createdHiringSignalAutomations HiringSignalAutomation[]
  intentAutomations              IntentAutomation[]
  scrapedIntentArticles          ScrapedIntentArticle[] @relation("UserScrapedIntentNews")
  assistantConversations         AssistantConversation[]
  aiTokenUsages                  AiTokenUsage[]
  createdCallCampaigns      CallCampaign[]        @relation("CallCampaignCreator")
  assignedCallCampaignLeads CallCampaignLead[]    @relation("CallCampaignLeadAssignee")
  intentSearchRecords       IntentSearchRecord[]
  intentEnrichedContacts    IntentEnrichedContact[]
  sentTaskMessages          TaskMessage[]         @relation("TaskMessageSender")
  receivedTaskMessages      TaskMessage[]         @relation("TaskMessageRecipient")

  emailSignatureHtml String?

  // Optional per-user attendance policy override (e.g. idle prompt threshold in minutes).
  idlePromptMin Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  UNPAID
  MATERNITY_PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Leave request submitted by an employee. HR/Admin can approve or reject.
// Dates are stored as DateTime but treated as date-only (time component
// is midnight UTC) -- consistent with the pragmatic style of this schema.
model LeaveRequest {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  type         LeaveType
  status       LeaveStatus @default(PENDING)
  startDate    DateTime
  endDate      DateTime
  reason       String?
  // HR/Manager who approved or rejected the request
  reviewedById String?
  reviewedBy   User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  LEAVE_APPROVED
  LEAVE_REJECTED
  TASK_ASSIGNED
  TASK_UPDATED
  BUG_ASSIGNED
  BUG_FIXED
  BUG_REOPENED
  FOLLOW_UP_DUE
  EMAIL_OPENED
  EMAIL_CLICKED
  // Distinct from FOLLOW_UP_DUE (that one's the Deal.followUpAt reminder) --
  // this is the email-open-triggered FollowUpTask from EngagementEventsService.
  EMAIL_FOLLOWUP_DUE
  // A new CompanyGrowthSignal (hiring velocity or a classified news
  // article) awaiting Sales review -- see CompanyGrowthService.
  COMPANY_GROWTH_SIGNAL
  GENERAL
  TASK_OVERDUE
  TASK_DUE_SOON
  TASK_UPDATE_REQUESTED
  TASK_UPDATE_SUBMITTED
  ATTENDANCE_LATE
  ATTENDANCE_IDLE
  ATTENDANCE_EARLY
  AGENT_QUIT
  ATTENDANCE_ABSENT
  ATTENDANCE_NO_CLOCKOUT
  ATTENDANCE_REPEAT_LATE
  ATTENDANCE_REVIEWED
  TASK_MESSAGE_RECEIVED
}

// Per-user in-app notification. Created by server-side event triggers
// (e.g. LeaveRequestsService, TasksService). Never mutated after creation
// except to mark isRead.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  // Client-side route the user should navigate to on click, e.g. "/hr" or "/tasks"
  link      String?
  createdAt DateTime         @default(now())
}

// ─── Work Sessions (Attendance) ──────────────────────────────────────────────

// Records a single work session started by the user clicking "Go Online".
// clockOutAt is null while the session is active. Duration is computed
// on clock-out as (clockOutAt - clockInAt) in minutes -- night-shift
// sessions (e.g. 7 PM → 4 AM next day) are handled correctly since
// we never assume clock-in and clock-out are on the same calendar date.
model WorkSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("UserWorkSessions", fields: [userId], references: [id], onDelete: Cascade)
  clockInAt   DateTime
  clockOutAt  DateTime?
  // Computed on clock-out, stored for easy reporting without re-calculating
  durationMin Int?
  // Calendar date of clock-in (for grouping daily summaries)
  date        DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Late-arrival accountability: set at clock-in when the first session of the
  // day starts after shift start + grace (see work-policy.ts). lateReason is
  // null until the employee answers the mandatory "why were you late" prompt.
  lateByMin    Int?
  lateReason   String?
  lateReasonAt DateTime?
  // Clocked out before the user's shiftEnd (minus grace); reason required.
  earlyByMin   Int?
  earlyReason  String?
  // Forgotten clock-out: the session was still open after MAX_OPEN_SESSION_HOURS
  // so the system closed it (at the end of the user's shift) and flagged it. The
  // employee is then asked to say when they really finished.
  // HR / manager review of the reasons above. null = not reviewed yet. EXCUSED
  // means it no longer counts against the person; REJECTED means it still does.
  lateReviewStatus      ReasonReviewStatus?
  lateReviewNote        String?
  lateReviewedById      String?
  lateReviewedAt        DateTime?
  earlyReviewStatus     ReasonReviewStatus?
  earlyReviewNote       String?
  earlyReviewedById     String?
  earlyReviewedAt       DateTime?
  autoClosed            Boolean   @default(false)
  autoClosedAt          DateTime?
  correctedClockOutAt   DateTime?
  correctionNote        String?
  correctionSubmittedAt DateTime?
  idleEvents   IdleEvent[]
  // Set when an admin-approved AttendanceAdjustmentRequest created this row; it
  // is shown as "Admin-approved adjustment" everywhere, never as a real clock-in.
  adjustmentRequestId String?
  // Set when the owner approved a late-start request for this day and the late
  // clock-in fell inside it: the late arrival is kept on record but excused.
  approvedLateStartId String?

  breaks           WorkBreak[]
  lastBreakEndedAt DateTime?
  screenCaptures   ScreenCapture[]
  screenRecordings ScreenRecording[]
  activityPings    ActivityPing[]
}

enum ReasonReviewStatus {
  EXCUSED
  REJECTED
}

// The company's attendance rules -- one row, editable by Admin/HR. Anything not
// overridden for a department (see AttendanceDeptPolicy) applies to everyone.
model AttendanceSettings {
  id                   String   @id @default("attendance")
  // Minutes after shift start before a clock-in counts as late.
  lateGraceMin         Int      @default(10)
  // Minutes before shift end that clocking out is not "early".
  earlyGraceMin        Int      @default(5)
  // Minutes with no activity before the "are you still working?" popup.
  idlePromptMin        Int      @default(5)
  // Minutes after shift start with no clock-in before someone is marked absent.
  absentAfterMin       Int      @default(60)
  // A session open this long is assumed forgotten and closed by the system.
  maxOpenSessionHours  Int      @default(14)
  // Alert manager/HR at this many late arrivals within repeatLateWindowDays.
  repeatLateThreshold  Int      @default(3)
  repeatLateWindowDays Int      @default(7)
  // Minimum worked minutes per working day (510 = 8h30m); less is a "short day".
  minWorkMinutes       Int      @default(510)
  // JS weekdays the company is closed every week (0 = Sunday ... 6 = Saturday).
  weeklyOffDays        Int[]    @default([0, 6])
  // Days before this ("YYYY-MM-DD") are never judged absent / short, so turning
  // tracking on doesn't retroactively mark everyone absent.
  absenceTrackingStart String?
  // A 60s activity ping counts as "active" when the OS saw input within this
  // many seconds, otherwise "idle" (drives the Active / idle card). Company-wide;
  // only the owner changes it. Applies to pings from the change onward.
  activeGapSec         Int      @default(3600)
  updatedAt            DateTime @updatedAt
  updatedById          String?
}

// Optional per-department overrides of the rules that make sense per team. A
// null field means "use the company value".
model AttendanceDeptPolicy {
  id             String     @id @default(uuid())
  departmentId   String     @unique
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lateGraceMin   Int?
  earlyGraceMin  Int?
  idlePromptMin  Int?
  absentAfterMin Int?
  minWorkMinutes Int?
  updatedAt      DateTime   @updatedAt
}

// A reusable set of working hours (e.g. "9-6 Sales") HR can apply to many people.
model ShiftTemplate {
  id         String   @id @default(uuid())
  name       String   @unique
  shiftStart String
  shiftEnd   String
  createdAt  DateTime @default(now())
}

// A company-wide non-working day (public holiday etc). `date` is the calendar
// day in the company timezone as "YYYY-MM-DD". Nobody is marked late or absent on it.
model CompanyHoliday {
  id          String   @id @default(uuid())
  date        String   @unique
  name        String
  createdById String?
  createdAt   DateTime @default(now())
}

// Written by the no-show job when an employee who was expected to work on `date`
// (company-timezone "YYYY-MM-DD") had still not clocked in an hour after their
// shift start, and was not on approved leave. Removed again if they clock in later.
model AbsenceRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserAbsences", fields: [userId], references: [id], onDelete: Cascade)
  date      String
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

// A stretch of 30+ minutes with no keyboard/mouse activity in the CRM while
// clocked in (and not on break). The employee must give a reason before they
// can continue.
model IdleEvent {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation("UserIdleEvents", fields: [userId], references: [id], onDelete: Cascade)
  workSessionId String
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  idleStartedAt DateTime
  idleMinutes   Int
  reason        String
  createdAt     DateTime    @default(now())

  @@index([workSessionId])
  @@index([userId, idleStartedAt])
}

model WorkBreak {
  id            String      @id @default(uuid())
  workSessionId String
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  startedAt     DateTime    @default(now())
  endedAt       DateTime?
  durationMin   Int?
  autoEnded     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([workSessionId])
}

// ─── Screen monitoring (disclosed) ───────────────────────────────────────────

// Periodic desktop screenshots captured by the desktop agent while a user is
// clocked in. Viewable by Admin, HR, or the capturing user's own-department
// Manager (see canViewScreenCaptures) -- never by the user themselves in this
// first pass. Images live on disk (see ScreenshotStorageService), not in the
// DB -- storagePath is just a pointer, cleaned up by the same 30-day
// opportunistic retention sweep pattern used for LoginEvent.
// A short screen recording captured by the desktop agent while an employee is
// clocked in -- three 3-minute clips an hour (at :00, :20, :40), so a 9-hour
// day produces 27. Replaces the periodic still screenshots: same disclosure,
// same clocked-in gate, same viewer rules as ScreenCapture.
//
// Video is far heavier than stills, so retention is deliberately much shorter
// here (see RETENTION_MS in screen-recordings.service.ts) and the files live on
// the mounted volume, never in the database.
model ScreenRecording {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation("UserScreenRecordings", fields: [userId], references: [id], onDelete: Cascade)
  workSessionId   String?
  workSession     WorkSession? @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  storageProvider String       @default("BUNNY")
  storagePath     String
  bunnyPath       String?
  // JPEG snapshot of the screen when the clip started; null for clips from agents before 0.7.5.
  thumbnailPath   String?
  uploadStatus    String       @default("UPLOADED")
  mimeType        String
  sizeBytes       Int
  // Actual clip length; normally 180s but a clock-out mid-clip cuts it short.
  durationSec     Int
  startedAt       DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@index([userId, startedAt])
  @@index([startedAt])
}

model ScreenCapture {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation("UserScreenCaptures", fields: [userId], references: [id], onDelete: Cascade)
  workSessionId String?
  workSession   WorkSession? @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  storagePath   String
  capturedAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([userId, capturedAt])
  @@index([capturedAt])
}

// A periodic "was there real mouse/keyboard input recently" ping from the
// desktop agent while clocked in -- an active/idle signal only, never what
// was typed or clicked. idleSeconds comes straight from the OS
// (Electron's powerMonitor.getSystemIdleTime()), which reports seconds since
// the last input system-wide without the app ever seeing individual key or
// click events. `active` is idleSeconds below a threshold, computed once at
// write time so aggregation queries don't need to re-derive it. Same
// viewer/retention model as ScreenCapture.
model ActivityPing {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation("UserActivityPings", fields: [userId], references: [id], onDelete: Cascade)
  workSessionId String?
  workSession   WorkSession? @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  idleSeconds   Int
  active        Boolean
  // Plain counts of keydown/mousedown events observed since the previous
  // ping -- never the key pressed or the click's coordinates/target, only
  // "how many". Same disclosed-counts-not-content boundary as idleSeconds
  // above; see CreateActivityPingDto and the desktop agent's uIOhook
  // listeners in main.ts, which are wired to increment these two counters
  // and nothing else. Default 0 + optional on the DTO so an un-upgraded
  // desktop agent build keeps sending pings during rollout.
  keystrokeCount Int         @default(0)
  clickCount     Int         @default(0)
  capturedAt    DateTime     @default(now())

  @@index([userId, capturedAt])
  @@index([capturedAt])
}

// ─── Login / logout audit trail ──────────────────────────────────────────────

// Audit trail of sign-in / sign-out events, surfaced to Admin + HR so they can
// see who accessed the system and when. One row per LOGIN or LOGOUT.
enum AuthEventType {
  LOGIN
  LOGOUT
  // A login attempt with a wrong password for an existing account -- used to
  // rate-limit brute-force guessing (see AuthService.validateCredentials's
  // lockout check). Never recorded for an unknown email/inactive account,
  // since there's no account to protect there.
  LOGIN_FAILED
}

model LoginEvent {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation("UserLoginEvents", fields: [userId], references: [id], onDelete: Cascade)
  type        AuthEventType
  // Best-effort request metadata (client IP + browser/device string). Nullable
  // because a logout may arrive without a resolvable session and headers can be
  // absent behind proxies.
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime      @default(now())
  loginPhotos LoginPhoto[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Recorded when an employee explicitly accepts the desktop agent's
// monitoring notice (see server/src/modules/auth/terms.ts) -- gates the
// desktop agent's screen-recording/activity loops until accepted. Unlike
// LoginEvent, deliberately never purged: this is a permanent consent audit
// trail, not an operational log.
model TermsAcceptance {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserTermsAcceptances", fields: [userId], references: [id], onDelete: Cascade)
  version    String
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime @default(now())

  @@index([userId, acceptedAt])
}

// Disclosed webcam photo captured at the moment of login (see PROJECT_STATUS.md
// phase 12) -- best-effort, never blocks sign-in. Same viewing audience as
// ScreenCapture (canViewMonitoringData): Admin, HR, or the employee's own-
// department Manager. loginEventId is a best-effort cross-reference to the
// audit trail, not a hard requirement -- a photo can exist without a
// resolvable event.
model LoginPhoto {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation("UserLoginPhotos", fields: [userId], references: [id], onDelete: Cascade)
  loginEventId String?
  loginEvent   LoginEvent? @relation(fields: [loginEventId], references: [id], onDelete: SetNull)
  type         String?     @default("CLOCK_IN")
  storagePath  String
  capturedAt   DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([userId, capturedAt])
  @@index([capturedAt])
  @@index([type])
}

model Department {
  id                    String              @id @default(uuid())
  name                  String              @unique
  description           String?
  // Display title for this department's MANAGER-tier role, e.g. "Head" for Dev
  // instead of the default "Manager" -- purely cosmetic, not a permission tier.
  managerTitle          String              @default("Manager")
  // Current monthly $ target for this department, shown as actual-vs-target on
  // the Team Performance view. Null = no target set. Single current value, no
  // history -- matches this schema's pragmatic style (see Deal.value).
  monthlyTarget         Int?
  dealApprovalThreshold Int                 @default(10000)
  headId                String?
  head                  User?               @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees             User[]              @relation("DepartmentEmployees")
  attendancePolicy      AttendanceDeptPolicy?
  projects              Project[]
  tasks                 Task[]
  deals                 Deal[]
  chatChannels          ChatChannel[]
  kbArticles            KBArticle[]
  sprints               Sprint[]
  epics                 Epic[]
  releases              Release[]
  seoKeywords           SeoKeyword[]
  seoAudits             SeoAudit[]
  seoBacklinks          SeoBacklink[]
  seoContentBriefs      SeoContentBrief[]
  seoCompetitors        SeoCompetitor[]
  seoKpiGoals           SeoKpiGoal[]
  marketingCampaigns    MarketingCampaign[]
  jobPostings           JobPosting[]        @relation("JobPostingOwningDepartment")
  hiringJobPostings     JobPosting[]        @relation("JobPostingHiringDepartment")
  candidates            Candidate[]
  interviews            Interview[]
  offers                Offer[]
  talentPools           TalentPool[]
  emailTemplates        EmailTemplate[]
  sequences             Sequence[]
  phoneNumbers          PhoneNumber[]
  callCampaigns         CallCampaign[]
  engagementEvents      EngagementEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EpicStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

model Epic {
  id           String     @id @default(uuid())
  name         String
  description  String?
  status       EpicStatus @default(PLANNING)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tasks        Task[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum ReleaseStatus {
  PLANNED
  RELEASED
  FAILED
}

model Release {
  id           String        @id @default(uuid())
  versionName  String
  releaseDate  DateTime?
  status       ReleaseStatus @default(PLANNED)
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tasks        Task[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  // The token issued when this one was rotated -- lets refresh() recover a
  // client whose rotation reply was lost (see AuthService.replacementWasNeverUsed).
  replacedById String?
  createdAt DateTime  @default(now())
}

// Single-use, time-limited token for the emailed password-reset flow. The raw
// token is emailed in the reset link; only its SHA-256 hash is stored here
// (same approach as RefreshToken).
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Project {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  status             ProjectStatus       @default(ACTIVE)
  ownerId            String
  owner              User                @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks              Task[]
  taskLists          TaskList[]
  sprints            Sprint[]
  startDate          DateTime?
  dueDate            DateTime?
  // Which department's work this belongs to -- drives department-scoped Manager
  // permissions (see DepartmentsService/ProjectsService.assertCanMutate). Null
  // (legacy rows, or explicitly unscoped) is manageable by any Manager.
  departmentId       String?
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  githubUrl          String?
  projectPassword    String?
  members            User[]              @relation("ProjectMembers")
  seoKeywords        SeoKeyword[]
  seoContentBriefs   SeoContentBrief[]
  seoBacklinks       SeoBacklink[]
  seoKpiGoals        SeoKpiGoal[]
  marketingCampaigns MarketingCampaign[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// A named grouping of tasks within a project (e.g. "Backend", "Design",
// "General") -- purely organizational, mirrors Zoho Projects' "task lists."
// Deleting a list doesn't delete its tasks (SetNull on Task.taskListId) --
// only deleting the whole project does, via this relation's Cascade.
model TaskList {
  id        String   @id @default(uuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  READY_FOR_TESTING
  CHANGES_REQUIRED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// A task can have several contributors (see Task.assignees) in addition to
// its single primary Task.assigneeId -- additive, not a replacement, so
// every existing single-assignee read/write keeps working unchanged.
model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("TaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Task {
  id                 String             @id @default(uuid())
  taskNumber         Int                @default(autoincrement())
  title              String
  description        String?
  status             TaskStatus         @default(TODO)
  priority           TaskPriority       @default(MEDIUM)
  position           Int                @default(0)
  projectId          String?
  project            Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId         String?
  assignee           User?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignees          TaskAssignee[]
  // The designated QA reviewer -- only this person (or a Manager/Admin) may
  // approve testing or move the task to DONE; see TasksService.
  testerId           String?
  tester             User?              @relation("TaskTester", fields: [testerId], references: [id], onDelete: SetNull)
  testingNotes       String?
  testingCompletedAt DateTime?
  testingApproved    Boolean            @default(false)
  creatorId          String
  creator            User               @relation("TaskCreator", fields: [creatorId], references: [id])
  dueDate            DateTime?
  // Same department-scoping purpose as Project.departmentId -- independent of
  // (not derived from) the task's project, since a task can exist without one.
  departmentId       String?
  department         Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  storyPoints        Int?
  type               TaskType           @default(FEATURE)
  sprintId           String?
  sprint             Sprint?            @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epicId             String?
  epic               Epic?              @relation(fields: [epicId], references: [id], onDelete: SetNull)
  releaseId          String?
  release            Release?           @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  // Schema-only for now -- no DTO exposes this yet (see MarketingCampaign).
  campaignId         String?
  campaign           MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  commits            GitCommit[]        @relation("TaskCommits")
  parentId           String?
  parent             Task?              @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks           Task[]             @relation("TaskSubtasks")
  updates            TaskUpdate[]
  // Grouping within a project (see TaskList) -- independent of Sprint/Epic/
  // Release, which are their own orthogonal groupings.
  taskListId         String?
  taskList           TaskList?          @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  // Only Project has startDate/dueDate historically; a task needs its own
  // startDate (distinct from dueDate) for the Zoho-style task panel's Start/
  // Due columns and Gantt-ish views.
  startDate          DateTime?
  // Freeform labels, not a normalized Tag model -- this app has no
  // cross-task tag search/reuse requirement yet, so a plain array column is
  // simplest (same pragmatic style as Contact.category/priority).
  tags               String[]           @default([])
  timeLogs           TimeLog[]
  bugs               Bug[]
  activityLogs       TaskActivityLog[]
  messages           TaskMessage[]      @relation("TaskMessages")
  overdueNotifiedAt  DateTime?
  // The dueDate we already sent a "due soon" reminder for -- a changed due
  // date re-arms the reminder without needing a reset in the update path.
  dueSoonNotifiedFor DateTime?
  lastUpdateRequestAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // --- extensibility for later phases (Files module) ---
  // files    Attachment[]
}

enum TimeLogStatus {
  PENDING
  APPROVED
  REJECTED
}

// A single day's worth of time a user spent on a task -- manual entry (not a
// live start/stop timer), same "type in what happened" pragmatic style as
// TaskUpdate, but numeric (minutes) instead of freeform text. Always
// self-logged (userId is always the actor, never set on someone else's
// behalf) -- same personal/attendance-like privacy stance as WorkSession.
// Goes through the same review workflow as LeaveRequest: starts PENDING,
// a Manager/Admin approves or rejects it, and it's locked from further
// self-edits once reviewed.
model TimeLog {
  id           String        @id @default(uuid())
  taskId       String
  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Not currently read/written by any endpoint -- ported for schema parity
  // only, same unwired state it's in upstream.
  subtaskId    String?
  userId       String
  user         User          @relation("TaskTimeLogAuthor", fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  startTime    String?
  endTime      String?
  minutes      Int
  note         String?
  status       TimeLogStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?         @relation("TimeLogReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([taskId])
  @@index([userId, date])
}

// Free-text daily progress note an assignee/creator/manager posts on a task
// while it's in progress -- tasks here are multi-day work items (not closed
// in one sitting), so this is how "what did you do on this task today"
// gets captured. Grouped by createdAt's calendar day in the UI rather than
// a separate editable date field, same pragmatic style as WorkSession.
model TaskUpdate {
  id            String   @id @default(uuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation("TaskUpdateAuthor", fields: [userId], references: [id], onDelete: Cascade)
  content       String
  // The structured fields below are not currently read/written by any
  // endpoint -- the daily-update form composes everything into `content`
  // instead (see ZohoTaskPagePanel). Ported for schema parity only, same
  // unwired state it's in upstream.
  date          DateTime @default(now())
  workCompleted String?
  nextPlan      String?
  blockers      String?
  notes         String?
  attachments   String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TaskActivityLog {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("TaskActivityAuthor", fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

enum TaskMessageType {
  OVERDUE_MESSAGE
  GENERAL_MESSAGE
  UPDATE_REQUEST
  TASK_UPDATE
  REPLY
}

model TaskMessage {
  id                 String          @id @default(uuid())
  taskId             String
  task               Task            @relation("TaskMessages", fields: [taskId], references: [id], onDelete: Cascade)
  senderId           String?
  sender             User?           @relation("TaskMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId        String?
  recipient          User?           @relation("TaskMessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  message            String          @db.Text
  messageType        TaskMessageType @default(GENERAL_MESSAGE)
  status             TaskStatus?
  progress           Int?
  workCompleted      String?         @db.Text
  currentWork        String?         @db.Text
  blockers           String?         @db.Text
  expectedCompletion DateTime?
  teamChatMessageId  String?
  readAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([taskId, createdAt])
  @@index([senderId])
  @@index([recipientId])
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BugStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_REVIEW
  REWORK_REQUIRED
  FIXED
  TO_BE_TESTED
  RETESTING
  CLOSED
  REOPENED
}

// A bug found while testing a Task -- deliberately its own tracked entity
// rather than reusing Task/TaskType.BUG, since a bug has its own lifecycle
// (severity/priority/status, a reporter distinct from an assignee, its own
// comment thread) layered on top of the task it was found on. See
// TasksService.validateStatusTransition -- a task can't reach DONE while it
// still has an open (non-CLOSED) bug.
model Bug {
  id               String           @id @default(uuid())
  bugNumber        Int              @default(autoincrement())
  title            String
  description      String?
  taskId           String
  task             Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Not currently read/written by any endpoint beyond being stored on
  // create -- there is no Subtask model distinct from Task itself.
  subtaskId        String?
  reporterId       String
  reporter         User             @relation("BugReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assigneeId       String?
  assignee         User?            @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  severity         BugSeverity      @default(MEDIUM)
  priority         BugPriority      @default(MEDIUM)
  status           BugStatus        @default(OPEN)
  attachments      String[]         @default([])
  fixSummary       String?
  rootCause        String?
  testingNotes     String?
  prLink           String?
  fixAttachmentUrl String?
  fixSubmittedAt   DateTime?
  fixSubmittedById String?
  fixSubmittedBy   User?            @relation("BugFixSubmitter", fields: [fixSubmittedById], references: [id], onDelete: SetNull)
  managerComments  String?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?            @relation("BugReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  comments         BugComment[]
  activityLogs     BugActivityLog[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([taskId])
}

model BugComment {
  id        String   @id @default(uuid())
  bugId     String
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("BugCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model BugActivityLog {
  id        String   @id @default(uuid())
  bugId     String
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("BugActivityAuthor", fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

enum LeadSource {
  MANUAL
  APOLLO
  IMPORT
}

model Company {
  id            String     @id @default(uuid())
  name          String     @unique
  domain        String?
  industry      String?
  notes         String?
  contacts      Contact[]
  deals         Deal[]
  // Apollo.io enrichment fields -- apolloId is used to dedupe re-imports.
  apolloId      String?    @unique
  linkedinUrl   String?
  employeeCount Int?
  source        LeadSource @default(MANUAL)
  calls         Call[]
  hiringSignals HiringSignal[]
  growthSignals CompanyGrowthSignal[]
  newsArticleLogs CompanyNewsArticleLog[]
  scrapedIntentArticles ScrapedIntentArticle[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Contact {
  id                  String               @id @default(uuid())
  firstName           String
  lastName            String
  email               String?
  phone               String?
  title               String?
  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals               Deal[]
  // Apollo.io enrichment fields -- apolloId is used to dedupe re-imports.
  apolloId            String?              @unique
  linkedinUrl         String?
  source              LeadSource           @default(MANUAL)
  enrichedAt          DateTime?
  // Freeform catch-all for anything a spreadsheet import couldn't map to a
  // real field -- e.g. "Follow UP notes" from a LinkedIn export, or extra
  // columns the user chose to keep rather than discard.
  notes               String?
  // Common spreadsheet-import fields -- all freeform strings rather than
  // enums since imported values (e.g. priority tiers like "A+"/"B") vary by
  // source sheet, not a fixed set this app controls.
  location            String?
  website             String?
  category            String?
  priority            String?
  enrollments         SequenceEnrollment[]
  bulkEmailRecipients BulkEmailRecipient[]
  activities          Activity[]           @relation("ActivityContact")
  calls               Call[]
  callCampaignLeads   CallCampaignLead[]
  syncedEmails        SyncedEmail[]
  engagementEvents    EngagementEvent[]
  followUpTasks       FollowUpTask[]
  // Cached rolling score from EngagementScoreService -- recomputed in place
  // on every EngagementEvent for this contact rather than summed on read, so
  // sorting/filtering the CRM by "hottest lead" doesn't require scanning
  // event history. engagementTier is derived from engagementScore by the
  // same service, using the fixed bands documented there.
  engagementScore     Int                  @default(0)
  engagementTier      String               @default("COLD")
  intentEnrichedContacts IntentEnrichedContact[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // EmailSyncEngineService looks up a Contact by address on every synced
  // message -- worth indexing once real sync traffic exists.
  @@index([email])
}

// One row per spreadsheet import run -- an audit trail so "did that import
// actually work" is answerable without grepping logs, same pattern as
// BulkEmailCampaign. Rows themselves aren't stored here, only the summary;
// the created/updated Contacts are the actual result.
model ContactImportBatch {
  id           String   @id @default(uuid())
  fileName     String
  importedById String
  importedBy   User     @relation(fields: [importedById], references: [id])
  totalRows    Int
  createdCount Int
  updatedCount Int
  skippedCount Int
  createdAt    DateTime @default(now())
}

enum DealStage {
  NEW_LEAD
  QUALIFIED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

// PENDING = an Employee tried to close a deal above the approval threshold;
// the stage change was withheld until a Manager/Admin approves or rejects it
// (see DealsService.update/approve/reject).
enum DealApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Deal {
  id                 String             @id @default(uuid())
  title              String
  // Whole currency units (no cents). Prisma's Decimal type doesn't round-trip
  // through JSON/TS cleanly; Int matches this codebase's pragmatic style.
  value              Int                @default(0)
  stage              DealStage          @default(NEW_LEAD)
  position           Int                @default(0)
  companyId          String?
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId          String?
  contact            Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId            String
  owner              User               @relation("DealOwner", fields: [ownerId], references: [id])
  notes              String?
  expectedCloseDate  DateTime?
  // Rep-set date for DealFollowUpsService's hourly reminder cron. Cleared
  // (set to null) by the rep dismissing/rescheduling, not by the cron itself.
  followUpAt         DateTime?
  // Set when the reminder notification+email actually fires for the current
  // followUpAt value, so the hourly cron doesn't re-notify every tick. Reset
  // to null whenever followUpAt changes (see DealsService.update).
  followUpNotifiedAt DateTime?
  // Same department-scoping purpose as Project.departmentId.
  departmentId       String?
  department         Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  // Set automatically by DealsService when stage transitions to/from WON or
  // LOST -- unlike updatedAt, which changes on any edit and can't answer
  // "when did this deal actually close" for dashboard stats.
  closedAt           DateTime?
  approvalStatus     DealApprovalStatus @default(NONE)
  activities         Activity[]
  documents          DealDocument[]
  calls              Call[]
  syncedEmails       SyncedEmail[]
  engagementEvents   EngagementEvent[]

  seoSourceKeywordId String?
  seoSourceKeyword   SeoKeyword? @relation("SeoSourceDeals", fields: [seoSourceKeywordId], references: [id], onDelete: SetNull)

  campaignId         String?
  campaign           MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  gclid              String?
  conversionLogs     OfflineConversionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ActivityType {
  CALL
  MEETING
  NOTE
  SYSTEM
}

// A file attached to a deal -- in practice the proposal PDF that was sent to
// the customer, prompted for when the deal reaches PROPOSAL_SENT. Kept as a
// record of exactly what was quoted, so a later dispute has the actual
// document rather than someone's memory of it.
//
// Unlike TrainingVideo (which stores a link), the bytes live on the server's
// volume: a proposal is small, private to the deal, and shouldn't depend on
// somebody's personal Drive still sharing it a year later.
// An image referenced by a user's email signature -- typically a company
// logo. Served from a PUBLIC endpoint on purpose: the <img> is loaded by the
// recipient's mail client, which has no session here. The id is a uuid, so
// the URL is unguessable, and nothing sensitive should ever be uploaded.
model EmailSignatureImage {
  id           String   @id @default(uuid())
  ownerId      String
  owner        User     @relation("SignatureImageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  originalName String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([ownerId])
}

model DealDocument {
  id           String   @id @default(uuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Original filename as the uploader had it -- shown in the UI and used for
  // the download filename. storagePath is the generated name on disk.
  originalName String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  note         String?
  uploaderId   String
  uploader     User     @relation("DealDocumentUploader", fields: [uploaderId], references: [id])
  createdAt    DateTime @default(now())

  @@index([dealId, createdAt])
}

model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  content     String
  // Who was actually spoken to. Optional because a NOTE often isn't about one
  // person, and every SYSTEM row is written by the server with nobody on the
  // other end. SetNull rather than Cascade: deleting a contact shouldn't erase
  // the record that the call happened.
  contactId   String?
  contact     Contact?     @relation("ActivityContact", fields: [contactId], references: [id], onDelete: SetNull)
  // Free text rather than an enum -- teams word their call dispositions
  // differently, and the frontend offers a suggested list without forcing it.
  outcome     String?
  // Call/meeting length in minutes. Null for notes and system rows.
  durationMin Int?
  occurredAt  DateTime     @default(now())
  dealId      String
  // Cascade, unlike this schema's usual SetNull for optional FKs: an activity
  // has no independent meaning without its deal (contrast Task.projectId,
  // which SetNulls since a task still means something without a project).
  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User         @relation("ActivityCreator", fields: [creatorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ChatChannel {
  id           String            @id @default(uuid())
  name         String? // null for DMs
  description  String?
  isDM         Boolean           @default(false)
  // A private group with an explicit member list (see ChatChannelMember). Department/public
  // channels have no member list: they are visible by department instead.
  isGroup      Boolean           @default(false)
  createdById  String?
  members      ChatChannelMember[]
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]
  reads        ChatChannelRead[]
  dmUserId1    String?
  dmUser1      User?             @relation("dmUser1", fields: [dmUserId1], references: [id], onDelete: SetNull)
  dmUserId2    String?
  dmUser2      User?             @relation("dmUser2", fields: [dmUserId2], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([dmUserId1, dmUserId2])
}

// Who is in a private group chat. Group admins can rename it and add/remove people.
model ChatChannelMember {
  id        String      @id @default(uuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin   Boolean     @default(false)
  joinedAt  DateTime    @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

// Per-user "I've seen everything up to here" marker for a channel, used to
// derive the sidebar's real unread-message badge (no unread state existed
// before this). Upserted whenever the user opens/views a channel.
model ChatChannelRead {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadAt DateTime    @default(now())

  @@unique([userId, channelId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  content   String
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  pinnedAt  DateTime?
  // "X added Y", "X left" lines shown centred in the chat instead of as a bubble.
  isSystem  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model KBArticle {
  id           String      @id @default(uuid())
  title        String
  content      String
  category     String // SOP, FAQ, GUIDE, STANDARD
  authorId     String
  author       User        @relation("KBArticleAuthor", fields: [authorId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum TaskType {
  FEATURE
  BUG
  REFACTOR
  CHORE
}

model Sprint {
  id           String     @id @default(uuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  status       String // PLANNING, ACTIVE, COMPLETED
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tasks        Task[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model GitCommit {
  id          String   @id @default(uuid())
  hash        String   @unique
  message     String
  branch      String   @default("main")
  authorId    String
  author      User     @relation("CommitAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?    @relation("TaskCommits", fields: [taskId], references: [id], onDelete: SetNull)
  isPR        Boolean  @default(false)
  prStatus    String? // OPEN, MERGED, CLOSED
  prNumber    Int?
  buildStatus String?
  createdAt   DateTime @default(now())
}

// A named marketing push a SeoKeyword/SeoContentBrief/Task can optionally be
// tagged under. Schema-only for now -- the /seo frontend's Campaigns tab
// manages campaigns as local component state, not through this model or any
// backend endpoint (no seo-marketing-campaigns module exists).
model MarketingCampaign {
  id           String            @id @default(uuid())
  name         String
  description  String?
  startDate    DateTime
  endDate      DateTime?
  budget       Float?            @default(0)
  spent        Float?            @default(0)
  targetLeads  Int?              @default(0)
  status       String            @default("ACTIVE")
  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  keywords     SeoKeyword[]
  briefs       SeoContentBrief[]
  tasks        Task[]
  deals        Deal[]
  googleAdsCampaignId String?
  googleAdsMetrics    GoogleAdsCampaignMetric[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model SeoKeyword {
  id           String             @id @default(uuid())
  term         String
  // Schema-only -- the create-keyword form has an intent picker but never
  // sends this field, so it's never actually written.
  searchIntent String?            @default("INFORMATIONAL")
  volume       Int                @default(0)
  difficulty   Int                @default(0)
  currentRank  Int?
  targetRank   Int?
  url          String?
  projectId    String?
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  campaignId   String?
  campaign     MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  departmentId String
  department   Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  leads        Deal[]             @relation("SeoSourceDeals")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model SeoAudit {
  id           String     @id @default(uuid())
  url          String
  score        Int        @default(0)
  issues       String // JSON string of issues
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  runAt        DateTime   @default(now())
}

enum BacklinkVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  LOST
}

model SeoBacklink {
  id              String                     @id @default(uuid())
  sourceUrl       String
  targetUrl       String
  // anchorText/spamScore/linkType/loggedBy/verifiedBy/rejectionNote are
  // schema-only -- the backlinks tab's "verification" is local component
  // state (handleVerifyBacklink never calls the API), and create/update DTOs
  // don't expose these fields.
  anchorText      String?
  domainAuthority Int                        @default(0)
  spamScore       Int                        @default(0)
  linkType        String                     @default("DOFOLLOW")
  status          BacklinkVerificationStatus @default(PENDING)
  loggedById      String?
  loggedBy        User?                      @relation("BacklinkLogger", fields: [loggedById], references: [id], onDelete: SetNull)
  verifiedById    String?
  verifiedBy      User?                      @relation("BacklinkVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectionNote   String?
  projectId       String?
  project         Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  departmentId    String
  department      Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
}

enum ContentBriefStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  UNDER_REVIEW
  REVISION_REQUIRED
  APPROVED
  PUBLISHED
}

enum SlaStatus {
  ON_TRACK
  AT_RISK
  OVERDUE
}

model SeoContentBrief {
  id                String                    @id @default(uuid())
  title             String
  targetKeyword     String
  // secondaryKeywords/targetWordCount/outlineJson/slaStatus/publishDate/
  // campaignId/reviewerId/rejectionReason are schema-only -- create/update
  // DTOs only expose title/targetKeyword/status/dueDate/assigneeId/content,
  // so ValidationPipe's whitelist strips the rest before they reach Prisma.
  secondaryKeywords String[]                  @default([])
  targetWordCount   Int                       @default(1500)
  outlineJson       String?
  status            ContentBriefStatus        @default(DRAFT)
  slaStatus         SlaStatus                 @default(ON_TRACK)
  dueDate           DateTime?
  publishDate       DateTime?
  projectId         String?
  project           Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  campaignId        String?
  campaign          MarketingCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assigneeId        String?
  assignee          User?                     @relation("BriefAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewerId        String?
  reviewer          User?                     @relation("BriefReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  content           String?
  rejectionReason   String?
  performance       ContentPerformanceMetric?
  qaChecklist       ContentBriefQaCheck[]
  departmentId      String
  department        Department                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

// Schema-only -- the "Content QA Drawer" checklist is local component state
// (qaChecks), never fetched from or persisted to this table.
model ContentBriefQaCheck {
  id           String          @id @default(uuid())
  briefId      String
  brief        SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  checkItem    String
  isPassed     Boolean         @default(false)
  verifiedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// Schema-only -- no endpoint reads or writes this; the Reports tab computes
// its numbers from existing keyword/brief/backlink data instead.
model ContentPerformanceMetric {
  id              String          @id @default(uuid())
  briefId         String          @unique
  brief           SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  pageViews       Int             @default(0)
  uniqueVisitors  Int             @default(0)
  ctr             Float           @default(0.0)
  rankingPosition Int?
  leadsGenerated  Int             @default(0)
  updatedAt       DateTime        @updatedAt
}

model SeoCompetitor {
  id           String     @id @default(uuid())
  domain       String
  da           Int        @default(0)
  traffic      Int        @default(0)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Schema-only -- like MarketingCampaign, no backend module or frontend API
// call manages this; the Executive Reporting tab doesn't fetch KPI goals.
model SeoKpiGoal {
  id           String     @id @default(uuid())
  title        String
  metricType   String
  targetValue  Float
  currentValue Float      @default(0.0)
  startDate    DateTime
  endDate      DateTime
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobPostingStatus {
  OPEN
  ON_HOLD
  CLOSED
  FILLED
}

enum FitBadge {
  PLATINUM_FIT
  GOLD_FIT
  SILVER_FIT
  REVIEW_REQUIRED
}

model JobPosting {
  id                 String           @id @default(uuid())
  jobCode            String? // e.g. REQ-2026-042
  title              String
  description        String?          @db.Text
  location           String?
  employmentType     EmploymentType   @default(FULL_TIME)
  status             JobPostingStatus @default(OPEN)
  targetHeadcount    Int              @default(1)
  filledHeadcount    Int              @default(0)
  targetJoiningDate  DateTime?
  budgetMin          Float?
  budgetMax          Float?
  currency           String           @default("USD")
  salaryPeriod       String           @default("YEARLY")
  priority           String           @default("HIGH")
  skillsRequired     String[]
  minExperienceYears Float            @default(0.0)

  hiringDepartmentId String?
  hiringDepartment   Department?       @relation("JobPostingHiringDepartment", fields: [hiringDepartmentId], references: [id], onDelete: SetNull)
  departmentId       String?
  department         Department?       @relation("JobPostingOwningDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  ownerId            String
  owner              User              @relation("JobPostingOwner", fields: [ownerId], references: [id])
  candidates         Candidate[]
  boardListings      JobBoardListing[]

  // Staffing-agency display fields for the Ceipal-style recruitment CRM view
  // (see src/components/ceipal) -- freeform strings rather than a relation to
  // Client, matching how the view already free-types a client name per job
  // rather than picking one from a managed list.
  client         String?
  clientJobId    String?
  businessUnit   String?
  states         String?
  clientBillRate String?
  sources        String[] @default([])
  industry       String?
  clearance      String?
  tags           String[] @default([])
  // { linkedin: bool, indeed: bool, ziprecruiter: bool, glassdoor: bool } --
  // a simple manual publish/unpublish flag the Ceipal UI toggles per board.
  // Deliberately separate from JobBoardListing/job-board-syndication below,
  // which is a different, real, automated syndication pipeline with its own
  // attempt/status lifecycle -- this is just a manual on/off switch.
  boardStatus    Json?
  recruitmentManager String?
  assignedTo         String?

  // Ceipal-style job-detail-panel collaboration sub-entities (tasks,
  // activity log, email merges, submissions, notes, documents) -- see the
  // models below.
  jobTasks       JobTask[]
  jobActivities  JobActivity[]
  jobEmailMerges JobEmailMerge[]
  jobSubmissions JobSubmission[]
  jobNotes       JobNote[]
  jobDocuments   JobDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A to-do item attached to a job posting (Ceipal job-detail-panel "Tasks"
// tab). assignedTo/assignedBy are freeform display strings, not User
// relations -- the frontend form free-types them rather than picking a real
// user.
model JobTask {
  id           String     @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  taskName     String
  dueDate      String?
  timeZone     String?
  assignedTo   String?
  assignedBy   String?
  status       String?
  completed    Boolean    @default(false)
  createdById  String
  createdBy    User       @relation("JobTaskCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum JobActivityType {
  CREATION
  STATUS_CHANGE
  BOARD
  TASK
  SUBMISSION
  BROADCAST
  GENERAL
}

// Append-only activity log entry for a job posting (Ceipal job-detail-panel
// "Activities" tab). `user` is a freeform display-name attribution separate
// from `createdBy` (the real authenticated actor), matching how the
// frontend already stamps activities with a computed display name.
model JobActivity {
  id           String          @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting      @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  user         String
  description  String          @db.Text
  type         JobActivityType @default(GENERAL)
  createdById  String
  createdBy    User            @relation("JobActivityCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
}

// A logged email-merge/broadcast campaign sent from a job posting (Ceipal
// job-detail-panel "Email Merges" tab). Records that the email was sent --
// does not itself send email.
model JobEmailMerge {
  id           String     @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  sentBy       String
  sentTo       String
  searchString String?
  zipLocation  String?
  subject      String
  details      String     @db.Text
  createdById  String
  createdBy    User       @relation("JobEmailMergeCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
}

// A candidate submission record for a job posting (Ceipal job-detail-panel
// "Submissions" tab) -- lighter-weight than the ATS's own Candidate/Offer
// pipeline, tracking just the staffing-style submission status shown there.
model JobSubmission {
  id           String     @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  candidateId  String?
  candidate    Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  name         String
  submittedBy  String
  contact      String?
  location     String?
  status       String
  statusLabel  String?
  payRate      String?
  billRate     String?
  createdById  String
  createdBy    User       @relation("JobSubmissionCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
}

// A freeform note attached to a job posting (Ceipal job-detail-panel "Notes"
// tab).
model JobNote {
  id           String     @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  text         String     @db.Text
  action       String?
  addedBy      String
  createdById  String
  createdBy    User       @relation("JobNoteCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
}

// Metadata for a file attached to a job posting (Ceipal job-detail-panel
// "Documents" tab) -- name/size/type only, same as the rest of this series;
// no file bytes are uploaded or stored (the frontend never sent them even
// in its earlier localStorage-only form).
model JobDocument {
  id           String     @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  name         String
  type         String?
  size         String?
  addedBy      String
  createdById  String
  createdBy    User       @relation("JobDocumentCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
}

// Job board syndication -- one row per (posting, board) tracking whether it's
// been published externally. LinkedIn/Naukri/Glassdoor are backed by stub
// adapters (simulated=true) until we have partner API access; Indeed is real,
// via a public XML feed rather than a per-job API call. See
// server/src/modules/job-board-syndication.
enum JobBoard {
  LINKEDIN
  NAUKRI
  INDEED
  GLASSDOOR
  ZIPRECRUITER
  MONSTER
  DICE
  SIMPLYHIRED
  CAREERBUILDER
  GOOGLE_JOBS
}

enum JobBoardListingStatus {
  PENDING
  POSTED
  FAILED
}

model JobBoardListing {
  id           String                @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting            @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  board        JobBoard
  status       JobBoardListingStatus @default(PENDING)
  // True while this board is served by a stub adapter that never actually
  // calls out anywhere -- surfaced in the UI so a fake post is never mistaken
  // for a real listing.
  simulated    Boolean               @default(false)
  externalId   String?
  externalUrl  String?
  errorMessage String?
  postedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([jobPostingId, board])
}

// Per-board API credentials for job board syndication, entered by a
// Recruitment manager in the Recruitment panel. Same encrypted-at-rest shape
// as ApolloConnection/JustCallConnection (see common/utils/token-crypto.ts).
// Unlike those, connect() has nothing to verify the key against yet --
// LinkedIn/Naukri/Glassdoor have no self-serve posting API available to us,
// so this only stores credentials for whenever a real partner integration
// exists; it does not make JobBoardListing.simulated false on its own. INDEED
// never gets a row here -- it's the public feed, no credentials involved.
model JobBoardConnection {
  board           JobBoard @id
  encryptedApiKey String
  apiKeyIv        String
  apiKeyAuthTag   String
  connectedById   String?
  connectedBy     User?    @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A single job-distribution aggregator (Broadbean, Appcast, JobTarget, etc.)
// that fans one posting out to many boards, as an alternative to negotiating
// a direct partnership with each board individually (see
// JobBoardConnection above -- those stay simulated because that per-board
// partner-API path is realistically out of reach for a single company; an
// aggregator is a commercial product any employer can buy). Singleton row
// (fixed id, same trick as ApolloConnection) since there's only ever one
// aggregator configured at a time. `provider` and `baseUrl` are free text,
// not an enum, because the vendor isn't fixed by this schema -- whichever
// one gets picked, its name/URL just get stored here. See
// adapters/aggregator-client.service.ts for how this gets used.
model JobDistributionAggregatorConnection {
  id              String   @id @default("job-distribution-aggregator-connection")
  provider        String
  baseUrl         String
  encryptedApiKey String
  apiKeyIv        String
  apiKeyAuthTag   String
  connectedById   String?
  connectedBy     User?    @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum CandidateStage {
  SOURCED
  SCREENING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  SELECTED
  OFFER_RELEASED
  OFFER_ACCEPTED
  JOINED
  REJECTED
  ON_HOLD
  // Legacy aliases
  APPLIED
  INTERVIEW
  OFFER
  HIRED
}

model Candidate {
  id                   String         @id @default(uuid())
  candidateCode        String? // e.g. CAN-8802
  firstName            String
  lastName             String
  email                String?
  phone                String?
  currentCompany       String?
  currentTitle         String?
  totalExperienceYears Float          @default(0.0)
  currentSalary        Float?
  expectedSalary       Float?
  noticePeriodDays     Int            @default(30)
  location             String?
  skills               String[]
  resumeUrl            String?
  source               String? // LINKEDIN, NAUKRI, INDEED, REFERRAL
  jobBoardUrl          String? // Direct link to candidate job board post/profile
  stage                CandidateStage @default(SOURCED)
  position             Int            @default(0)
  rejectionReason      String?

  // AI Matching Scores & Fit Badges
  aiMatchScore      Float    @default(85.0) // 0 to 100%
  skillMatchScore   Float    @default(88.0)
  expMatchScore     Float    @default(85.0)
  locMatchScore     Float    @default(90.0)
  salaryMatchScore  Float    @default(80.0)
  noticeMatchScore  Float    @default(82.0)
  cultureMatchScore Float    @default(86.0)
  fitBadge          FitBadge @default(GOLD_FIT)
  aiSummary         String?  @db.Text

  jobPostingId   String
  jobPosting     JobPosting            @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User                  @relation("CandidateOwner", fields: [ownerId], references: [id])
  departmentId   String?
  department     Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  interviews     Interview[]
  offers         Offer[]
  riskProfile    CandidateRiskProfile?
  poolMembers    TalentPoolMember[]
  recruiterTasks RecruiterTaskQueue[]
  jobSubmissions JobSubmission[]
  gclid          String?
  utmSource      String?
  utmCampaign    String?
  conversionLogs OfflineConversionLog[]

  // Ceipal-style applicant view fields (src/components/ceipal) -- city/state
  // as separate display fields alongside the existing single `location`,
  // matching that view's column layout.
  city       String?
  state      String?
  isStarred  Boolean @default(false)
  badgeCount Int     @default(0)

  // Ceipal-style applicant profile fields captured on the create/detail
  // panels (src/components/ceipal/views) -- persisted here instead of only
  // in browser localStorage so they survive a refresh and are visible to
  // every recruiter, not just the one who uploaded the resume.
  summary               String?  @db.Text
  educationDegree       String?
  educationInstitution  String?
  educationYear         String?
  certifications        String[]
  workAuthorization     String?
  willingToRelocate     String?

  appliedAt      DateTime  @default(now())
  stageEnteredAt DateTime  @default(now())
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  BEHAVIORAL
  ONSITE
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

model Interview {
  id                  String          @id @default(uuid())
  candidateId         String
  candidate           Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewerId       String?
  interviewer         User?           @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User            @relation("InterviewCreator", fields: [createdById], references: [id])
  type                InterviewType   @default(PHONE_SCREEN)
  scheduledAt         DateTime
  durationMinutes     Int             @default(30)
  location            String?
  meetingUrl          String?
  recordingUrl        String?
  aiTranscriptSummary String?         @db.Text
  status              InterviewStatus @default(SCHEDULED)
  feedback            String?         @db.Text
  rating              Int?

  technicalRating       Int?    @default(4)
  communicationRating   Int?    @default(4)
  problemSolvingRating  Int?    @default(4)
  cultureFitRating      Int?    @default(4)
  overallRecommendation String? // STRONG_HIRE, HIRE, NO_HIRE, STRONG_NO_HIRE

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  RESCINDED
}

model Offer {
  id                String      @id @default(uuid())
  offerCode         String? // e.g. OFF-2026-104
  candidateId       String
  candidate         Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User        @relation("OfferCreator", fields: [createdById], references: [id])
  salary            Int
  joiningBonus      Float       @default(0.0)
  variablePay       Float       @default(0.0)
  stockOptions      String?
  targetJoiningDate DateTime?
  offerExpiryDate   DateTime?
  approvalState     String      @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED
  startDate         DateTime?
  status            OfferStatus @default(DRAFT)
  sentAt            DateTime?
  respondedAt       DateTime?
  notes             String?     @db.Text
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Ceipal-style placement-record billing fields (src/components/ceipal) --
  // freeform display strings ("$85.00/hr") rather than numeric, matching how
  // that view already free-types rates rather than computing them.
  placementCode     String?
  placementType     String?
  clientPrimeVendor String?
  businessUnit      String?
  clientBillRate    String?
  payRate           String?
  perDiemHr         String?
  overhead          String?
  margin            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A staffing client company for the Ceipal-style recruitment CRM
// (src/components/ceipal) -- deliberately separate from Company, which is
// the general sales CRM's prospect/customer entity (linked to Deal/Contact,
// Apollo-enriched). Conflating the two would mix two different domains that
// happen to share the word "company".
model Client {
