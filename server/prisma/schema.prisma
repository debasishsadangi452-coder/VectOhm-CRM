enum EboardingStatus {
  DRAFT
  INITIATED
  RESPONDED
  VERIFIED
  NEGOTIATE
  JOINED
  REJECTED
  DISQUALIFIED
  CANCELLED
}

// A candidate's onboarding/e-boarding intake record for the Ceipal-style
// recruitment CRM. Freeform strings throughout (including dates) rather than
// typed/relational fields, matching the large intake form on the frontend --
// same rationale as Contact's freeform spreadsheet-import fields.
model Eboarding {
  id             String          @id @default(uuid())
  name           String
  middleName     String?
  lastName       String?
  email          String
  alternateEmail String?
  phone          String?
  gender         String?
  jobTitle       String?
  country        String?
  state          String?
  city           String?
  zipCode        String?
  streetAddress  String?
  employmentType String?
  onboardingCode String?
  taxTerms       String?
  vendorName     String?
  vendorEmail    String?
  atsBu          String?
  client         String?
  startDate      String?
  endDate        String?
  joiningDate    String?
  billRate       String?
  payRate        String?
  placementType  String?
  comments       String?         @db.Text
  status         EboardingStatus @default(DRAFT)
  // Array of { id, name, completed } -- no independent querying need, so a
  // JSON blob rather than a separate relational table.
  checklist      Json?
  initiatedOn    String?
