model OfflineConversionLog {
  id              String     @id @default(uuid())
  gclid           String
  conversionName  String
  conversionTime  DateTime   @default(now())
  conversionValue Float      @default(0.0)
  currencyCode    String     @default("USD")
  status          String     @default("SUCCESS")
  errorMessage    String?
  dealId          String?
  deal            Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  candidateId     String?
  candidate       Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  uploadedAt      DateTime   @default(now())

  @@index([gclid])
  @@index([dealId])
}

enum EmailDirection {
  SENT
  RECEIVED
}

// A message synced from a connected OAuth mailbox (sent or received),
// linked to a Contact/Deal by address match at ingest time -- see
// EmailSyncEngineService. Named SyncedEmail, not EmailMessage, to avoid
// colliding with the EmailMessage interface already exported by
// common/utils/mailer.ts (the outbound send payload shape).
model SyncedEmail {
  id                String              @id @default(uuid())
  connectionId      String
  connection        UserEmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  direction         EmailDirection
  fromAddress       String
  toAddresses       String[]
  ccAddresses       String[]
  subject           String
  bodyPreview       String
  bodyHtml          String?
  providerMessageId String
  threadId          String?
  occurredAt        DateTime
  contactId         String?
  contact           Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId            String?
  deal              Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  isRead            Boolean             @default(false)
  createdAt         DateTime            @default(now())

  @@unique([connectionId, providerMessageId])
  @@index([contactId])
  @@index([dealId])
  @@index([threadId])
}

// Permanent cache of Apollo API responses, keyed by call type + a normalized
// (sorted, lowercased) hash of the request params. Covers both searches
// (people/organizations by name/keywords/etc.) and the credit-consuming
// reveal calls (person match, organization enrich) that import/enrich
// trigger -- so searching or importing the same name/domain again is served
// from Postgres instead of re-hitting Apollo. Never expires: Apollo contact
// data doesn't change often enough to justify the complexity of a TTL, and
// the point is to never pay for the same lookup twice.
model ApolloCache {
  id        String   @id @default(uuid())
  kind      String
  queryKey  String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([kind, queryKey])
  @@index([kind])
}

// A reusable outreach email, owned collaboratively by the Sales department
// (any Sales member can edit/delete any template -- same "shared team
// resource" convention as the recruitment candidate pipeline, not the
// owner/creator-scoped convention used by Task/Deal). bodyHtml/subject can
// contain {{firstName}} {{lastName}} {{title}} {{companyName}} merge fields,
// rendered by common/utils/merge-fields.ts. Will also be referenced by
// SequenceStep once Sequences are built.
// Who can see and use an email template besides the person who made it.
enum EmailTemplateVisibility {
  PRIVATE
  DEPARTMENT
  EVERYONE
}

model EmailTemplate {
  id                 String              @id @default(uuid())
  name               String
  subject            String
  bodyHtml           String
  // PRIVATE = only the creator; DEPARTMENT = everyone in the creator's department; EVERYONE = all Sales
  // and Recruitment users. Templates made before this existed stay EVERYONE.
  visibility         EmailTemplateVisibility @default(PRIVATE)
  // true when the first draft was written by the AI (it can still be edited like any template).
  aiGenerated        Boolean             @default(false)
  // Append the *sender's* signature at send time rather than baking one
  // person's sign-off into a template the whole team shares.
  appendSignature    Boolean             @default(false)
  departmentId       String?
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creatorId          String
  creator            User                @relation(fields: [creatorId], references: [id])
  sequenceSteps      SequenceStep[]
  bulkEmailCampaigns BulkEmailCampaign[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  MANUAL
}

// A global "never email this address again" list -- deliberately NOT
// department-scoped (an unsubscribe must be honored company-wide, not just
// by the team that sent the email that triggered it). Checked by the
// Sequence send engine before every send; also enforced independent of
// EmailTemplate/Sequence lifecycle so it survives even if those are deleted.
model EmailSuppression {
  id        String            @id @default(uuid())
  email     String            @unique
  reason    SuppressionReason
  createdAt DateTime          @default(now())
}

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED
}

enum SendStatus {
  PENDING
  SENT
  FAILED
}

// A drip campaign definition -- an ordered list of SequenceSteps, each
// firing delayDays after the previous one (or after enrollment, for the
// first step). Same collaborative Sales-team ownership as EmailTemplate.
model Sequence {
  id               String               @id @default(uuid())
  name             String
  description      String?
  status           SequenceStatus       @default(DRAFT)
  departmentId     String?
  department       Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creatorId        String
  creator          User                 @relation(fields: [creatorId], references: [id])
  steps            SequenceStep[]
  enrollments      SequenceEnrollment[]
  engagementEvents EngagementEvent[]
  followUpTasks    FollowUpTask[]
  // Opt-in only -- see FollowUpMode's doc comment.
  followUpMode     FollowUpMode         @default(MANUAL)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  hiringSignalAutomations HiringSignalAutomation[]
}

// Which public job-board API a HiringSignal was detected through. LinkedIn is
// deliberately absent -- see HiringSignalAutomation's doc comment.
enum HiringSignalSource {
  GREENHOUSE
  ASHBY
  LEVER
  ADZUNA
}

// A recruiter/Sales-configured "watch for companies hiring like X, then
// outreach automatically" rule. Discovery (finding companies with fresh
// hiring activity) is the only genuinely new piece this module adds --
// enrichment (ApolloService.searchPeople/importPeople) and sending
// (SequencesService.enroll + SequenceEngineService) already exist and are
// reused as-is. Deliberately excludes LinkedIn as a source: the only way to
// pull LinkedIn job data without their (paid, partner-gated) API is scraping
// their guest-search HTML, which violates LinkedIn's Terms of Service.
model HiringSignalAutomation {
  id            String              @id @default(uuid())
  name          String
  isActive      Boolean             @default(true)
  // Filters forwarded to ApolloService.searchOrganizations for ICP-based
  // discovery.
  industries    String[]
  locations     String[]
  keywords      String?
  // Adzuna open-market discovery -- surfaces companies by role/keyword
  // rather than requiring them to already match an ICP search. Only runs if
  // enabled, since it needs the user's own ADZUNA_APP_ID/ADZUNA_APP_KEY.
  adzunaEnabled      Boolean  @default(false)
  adzunaRoleKeywords String[]
  // Titles that count as a valid decision-maker for this automation's
  // outreach -- forwarded to ApolloService.searchPeople as personTitles.
  targetTitles  String[]
  sequenceId    String
  sequence      Sequence            @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User                @relation(fields: [createdById], references: [id])
  signals       HiringSignal[]
  lastRunAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

// One row per (company, job posting) hiring signal detected by an
// automation. `@@unique` on the source's own job id is what makes repeated
// discovery runs idempotent instead of creating duplicate signals every run.
model HiringSignal {
  id            String                  @id @default(uuid())
  companyId     String
  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  automationId  String?
  automation    HiringSignalAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  source        HiringSignalSource
  externalJobId String
  jobTitle      String
  jobUrl        String
  detectedAt    DateTime                @default(now())

  // companyId included even though a source's externalJobId is likely
  // already globally unique -- cheap insurance against a source that turns
  // out to scope ids per-account rather than globally.
  @@unique([companyId, source, externalJobId])
}

// ─── Intent Hiring Intelligence & Decision Maker Pipeline ──────────────────

model IntentSearchRecord {
  id          String                @id @default(uuid())
  role        String
  location    String?
  totalFound  Int                   @default(0)
  createdById String?
  createdBy   User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  leads       IntentDiscoveredJob[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([createdAt])
}

model IntentDiscoveredJob {
  id                   String              @id @default(uuid())
  searchRecordId       String?
  searchRecord         IntentSearchRecord? @relation(fields: [searchRecordId], references: [id], onDelete: Cascade)
  externalJobId        String?
  jobTitle             String
  jobUrl               String
  companyName          String
  companyLocation      String?
  companyDomain        String?
  salary               String?
  jobDescription       String?             @db.Text
  discoveredAt         DateTime            @default(now())
  source               String              @default("ADZUNA")
  initialDecisionMaker Json?
  enriched             Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([searchRecordId])
  @@index([companyName])
}

model IntentEnrichedContact {
  id                     String    @id @default(uuid())
  companyName            String
  companyDomain          String?
  personName             String
  firstName              String?
  lastName               String?
  title                  String
  departmentCategory     String    @default("FOUNDER_EXEC") // "FOUNDER_EXEC" | "HR_TALENT" | "OTHER"
  email                  String?
  linkedinUrl            String?
  apolloId               String?
  sourceJobTitle         String?
  sourceJobUrl           String?
  discoveredJobId        String?
  contactId              String?
  contact                Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sequenceEnrolled       Boolean   @default(false)
  autoEnrolledSequenceId String?
  sequenceName           String?
  enrolledAt             DateTime?
  createdById            String?
  createdBy              User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([companyName])
  @@index([email])
  @@index([createdAt])
}

// A reviewable "this company looks like it's expanding" signal, shown to
// Sales for an explicit Accept/Dismiss decision -- unlike HiringSignal
// (which auto-enrolls silently), nothing here emails anyone until a human
// accepts it. HIRING_VELOCITY is derived from existing HiringSignal data
// (no new integration); the NEWS_* types come from CompanyNewsClassifierService
// classifying NewsApiAdapter results with Claude. See CompanyGrowthService.
enum CompanyGrowthSignalType {
  HIRING_VELOCITY
  NEWS_EXPANSION
  NEWS_FUNDING
  NEWS_DEAL
  // Apollo's own org search data (mixed_companies/search), not a news/job-
  // board integration -- deterministic, no LLM classification involved.
  // APOLLO_HIRING: the company has active job postings per Apollo's own
  // "# Active Job Postings" filter (organization_num_jobs_range).
  // APOLLO_HEADCOUNT_GROWTH: Apollo's own computed
  // organization_headcount_six_month_growth crossed the threshold.
  APOLLO_HIRING
  APOLLO_HEADCOUNT_GROWTH
}

enum CompanyGrowthSignalStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model CompanyGrowthSignal {
  id        String                    @id @default(uuid())
  companyId String
  company   Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      CompanyGrowthSignalType
  status    CompanyGrowthSignalStatus @default(PENDING)
  // Plain-language, sales-facing summary -- Claude-generated for NEWS_*
  // types (e.g. "Raised $40M Series B, plans to double engineering
  // headcount"), built from the HiringSignal count for HIRING_VELOCITY.
  summary   String
  // The source news article. Always null for HIRING_VELOCITY.
  sourceUrl String?
  // Which Sequence the resolved contact was enrolled into once accepted --
  // null until status flips to ACCEPTED.
  sequenceId   String?
  reviewedById String?
  reviewedBy   User?                  @relation("GrowthSignalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  detectedAt   DateTime               @default(now())

  // Dedupes NEWS_* signals by article -- sourceUrl is always set for those.
  // HIRING_VELOCITY rows always have sourceUrl=null, so this constraint
  // can't dedupe them (Postgres treats NULL <> NULL); that's handled in
  // CompanyGrowthService.detectHiringVelocity via a 14-day lookback check
  // instead.
  @@unique([companyId, type, sourceUrl])
  @@index([companyId, detectedAt])
  @@index([status, detectedAt])
}

// A permanent record of every article NewsAPI returned during a news scan,
// one row per (company, article) regardless of what Claude decided --
// independent of CompanyGrowthSignal, which only holds the ones that were
// classified relevant. Exists so the news pipeline is auditable/debuggable
// even when ANTHROPIC_API_KEY isn't set yet (classified stays false,
// relevant stays null -- the row is still written, proving NewsAPI itself
// is working) and so re-classifying the same article twice never happens.
// See CompanyGrowthService.scanCompanyNews.
model CompanyNewsArticleLog {
  id          String                   @id @default(uuid())
  companyId   String
  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  url         String
  sourceName  String?
  publishedAt DateTime?
  fetchedAt   DateTime                 @default(now())
  // Whether Claude has looked at this article yet -- false/null until
  // ANTHROPIC_API_KEY is configured and a scan actually classifies it.
  classified  Boolean                  @default(false)
  relevant    Boolean?
  signalType  CompanyGrowthSignalType?

  @@unique([companyId, url])
  @@index([companyId, fetchedAt])
}

model SequenceStep {
  id         String         @id @default(uuid())
  sequenceId String
  sequence   Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  delayDays  Int
  templateId String
  template   EmailTemplate  @relation(fields: [templateId], references: [id])
  sends      SequenceSend[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([sequenceId, order])
}

// One contact's progress through a sequence. The send engine (a periodic
// job, see modules/sequences/sequence-engine.service.ts) scans for rows
// where status=ACTIVE and nextSendAt<=now(), sends the step at
// currentStepOrder, then either advances to the next step (bumping
// nextSendAt by that step's delayDays) or marks the enrollment COMPLETED
// if there is no next step.
model SequenceEnrollment {
  id               String           @id @default(uuid())
  sequenceId       String
  sequence         Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status           EnrollmentStatus @default(ACTIVE)
  currentStepOrder Int              @default(0)
  nextSendAt       DateTime
  enrolledById     String
  enrolledBy       User             @relation(fields: [enrolledById], references: [id])
  stoppedReason    String?
  sends            SequenceSend[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([sequenceId, contactId])
}

// One row per actually-attempted send (not per scheduled step) -- the
// Activity feed and idempotency/audit trail for the engine.
model SequenceSend {
  id                String             @id @default(uuid())
  enrollmentId      String
  enrollment        SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  // Nullable + SetNull (not Restrict/Cascade): deleting a single surviving
  // step shouldn't be blocked by, or destroy, its send history -- the row
  // just loses its step reference. Whole-sequence deletion still fully
  // cleans up via the enrollmentId cascade above.
  stepId            String?
  step              SequenceStep?      @relation(fields: [stepId], references: [id], onDelete: SetNull)
  status            SendStatus
  errorMessage      String?
  sentAt            DateTime           @default(now())
  openedAt          DateTime?
  openCount         Int                @default(0)
  // Mirrors BulkEmailRecipient.dismissedAt -- same "I already followed up
  // some other way" escape hatch for the Sequences half of the panel.
  dismissedAt       DateTime?
  // Click-tracking (Engagement Intelligence Phase 1): set by the
  // /tracking/click redirect route, mirroring openedAt/openCount above.
  clickedAt         DateTime?
  clickCount        Int                @default(0)
  // Reserved for Phase 4 reply-linking: populated from the OAuth send
  // response when available (SMTP/HTTP-fallback sends have no reliable
  // message-id capture path), then matched against inbound SyncedEmail.
  // threadId to detect EMAIL_REPLIED. Null today -- nothing reads these yet.
  providerMessageId String?
  threadId          String?

  // EmailSyncEngineService now looks up a send by threadId on every RECEIVED
  // synced email (Phase 4 reply-linking) -- without this the lookup is a
  // full table scan per inbound email.
  @@index([threadId])
}

enum BulkSendStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// A one-shot blast of a single template to many recipients at once (as
// opposed to Sequence, which is a scheduled multi-step drip). Recipients can
// come from existing CRM Contacts (including ones sourced from Apollo --
// see Contact.source) and/or a pasted/CSV list of raw emails not yet in the
// CRM. Same collaborative Sales-team ownership as EmailTemplate/Sequence.
model BulkEmailCampaign {
  id               String               @id @default(uuid())
  name             String
  // Exactly one of (templateId) or (subject + bodyHtml) is set -- enforced in
  // BulkEmailService.create, since Prisma can't express an XOR constraint.
  // A saved template is the reusable path; the inline pair is a one-off email
  // written for this campaign's recipients only, which deliberately never
  // lands in the shared Templates list.
  templateId       String?
  template         EmailTemplate?       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  subject          String?
  bodyHtml         String?
  appendSignature  Boolean              @default(false)
  // Rewrite each recipient's email with AI (using the content above as the base and the optional
  // instructions as guidance), so recipients don't all get identical text.
  aiPersonalize    Boolean              @default(false)
  aiInstructions   String?
  creatorId        String
  creator          User                 @relation(fields: [creatorId], references: [id])
  emailConnectionId String?
  emailConnection   UserEmailConnection? @relation(fields: [emailConnectionId], references: [id], onDelete: SetNull)
  recipients       BulkEmailRecipient[]
  engagementEvents EngagementEvent[]
  followUpTasks    FollowUpTask[]
  // Opt-in only -- see FollowUpMode's doc comment. A campaign starts MANUAL
  // and stays that way unless the creator/a Manager explicitly turns on
  // Assisted or Automated follow-ups.
  followUpMode     FollowUpMode         @default(MANUAL)
  createdAt        DateTime             @default(now())
}

// One row per recipient targeted by a campaign. The engine (a periodic job,
// see modules/bulk-email/bulk-email-engine.service.ts) processes a capped
// batch of PENDING rows per tick -- spreading a large blast over several
// cron ticks instead of firing everything in one second -- and flips each
// to SENT/FAILED/SKIPPED (suppressed). contactId is nullable: a raw pasted
// email with no matching CRM contact still gets a row, just without
// merge-field personalization or a live contact to re-check later.
model BulkEmailRecipient {
  id                String            @id @default(uuid())
  campaignId        String
  campaign          BulkEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  email             String
  status            BulkSendStatus    @default(PENDING)
  errorMessage      String?
  sentAt            DateTime?
  openedAt          DateTime?
  openCount         Int               @default(0)
  // Set when a rep clears this from the Follow-Up Reminders panel -- e.g.
  // they called the lead instead of re-emailing. Excluded from
  // BulkEmailService.findFollowUps once set; nothing else reads it.
  dismissedAt       DateTime?
  // Click-tracking (Engagement Intelligence Phase 1): set by the
  // /tracking/click redirect route, mirroring openedAt/openCount above.
  clickedAt         DateTime?
  clickCount        Int               @default(0)
  // Reserved for Phase 4 reply-linking -- see SequenceSend's identical pair
  // for why these are OAuth-only and unpopulated in Phase 1.
  providerMessageId String?
  threadId          String?
  createdAt         DateTime          @default(now())

  @@index([campaignId, status])
  @@index([status, createdAt])
  // EmailSyncEngineService now looks up a recipient by threadId on every
  // RECEIVED synced email (Phase 4 reply-linking) -- without this the
  // lookup is a full table scan per inbound email.
  @@index([threadId])
}

// ─── Engagement Intelligence ─────────────────────────────────────────────────

// Every tracked interaction across Bulk Email, Sequences, Deals, Tasks, and
// Activities becomes one of these -- a single append-only feed that the
// Engagement Center, lead scoring, and follow-up automation all read from
// instead of each module inventing its own notion of "something happened."
// recipientId points at whichever BulkEmailRecipient/SequenceSend row this
// event came from (the two live in separate tables, so it's a plain string,
// not a Prisma relation) -- optional, since Deal/Task/Activity-sourced events
// have no such row at all.
enum EngagementEventType {
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_REPLIED
  FOLLOWUP_SCHEDULED
  FOLLOWUP_SENT
  FOLLOWUP_DISMISSED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  MEETING_BOOKED
  CALL_LOGGED
  TASK_COMPLETED
  SEQUENCE_STARTED
  SEQUENCE_COMPLETED
}

model EngagementEvent {
  id            String              @id @default(uuid())
  type          EngagementEventType
  contactId     String?
  contact       Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId        String?
  deal          Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaign      BulkEmailCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sequenceId    String?
  sequence      Sequence?           @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  recipientId   String?
  // The rep this event is "for" -- drives visibility scoping (mirrors
  // Deal.ownerId) and who gets notified. Null for events with no natural
  // owner (rare; kept nullable rather than forcing a fallback).
  ownerId       String?
  owner         User?               @relation("EngagementEventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  // Free-form per-type extra context (e.g. clicked URL, deal stage
  // before/after) that doesn't warrant its own column.
  metadata      Json?
  occurredAt    DateTime            @default(now())
  followUpTasks FollowUpTask[]

  @@index([contactId])
  @@index([dealId])
  @@index([campaignId])
  @@index([sequenceId])
  @@index([ownerId, occurredAt])
  @@index([type, occurredAt])
}

// How a due FollowUpTask is handled by FollowUpAutomationService's cron:
// MANUAL (default) only notifies the rep, who drafts and sends by hand.
// ASSISTED generates an AI draft and notifies the rep to review/send it.
// AUTOMATED generates and sends without human review -- opt-in per
// Sequence/Campaign for exactly that reason (see schema.prisma's Sequence/
// BulkEmailCampaign fields below), never a global default.
enum FollowUpMode {
  MANUAL
  ASSISTED
  AUTOMATED
}

enum FollowUpTaskStatus {
  PENDING
  SENT
  DISMISSED
  COMPLETED
}

// Created automatically by EngagementEventsService.record() the moment a
// tracked email is first opened (dueAt = openedAt + 24h) -- see its
// EMAIL_OPENED branch. FollowUpAutomationService's cron picks up whatever is
// PENDING and past dueAt, then branches on the owning Campaign/Sequence's
// followUpMode. engagementId links back to the EMAIL_OPENED event that
// created this task, for the "why was I asked to follow up" context.
model FollowUpTask {
  id             String             @id @default(uuid())
  engagementId   String?
  engagement     EngagementEvent?   @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  contactId      String
  contact        Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // BulkEmailRecipient.id or SequenceSend.id -- same "two source tables, so
  // a plain string, not a relation" reasoning as EngagementEvent.recipientId.
  recipientId    String?
  campaignId     String?
  campaign       BulkEmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sequenceId     String?
  sequence       Sequence?          @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  dueAt          DateTime
  status         FollowUpTaskStatus @default(PENDING)
  assignedTo     String
  assignee       User               @relation("FollowUpTaskAssignee", fields: [assignedTo], references: [id], onDelete: Cascade)
  // Populated by FollowUpAiService, either by the cron (Assisted/Automated)
  // or the rep's own "generate a draft" click (Manual). Editable before
  // send -- POST /follow-ups/:id/send takes the (possibly rep-edited)
  // subject/body directly rather than re-reading these columns, so they're
  // a starting point, not the source of truth for what actually gets sent.
  aiDraftSubject String?
  aiDraftBody    String?
  // Set the first time the cron notifies for this task, so a Manual/
  // Assisted task pending across multiple 30-minute ticks doesn't re-notify
  // every tick -- same dedup reasoning as Deal.followUpNotifiedAt.
  notifiedAt     DateTime?
  sentAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([assignedTo, status, dueAt])
}

// A link to a screen-recorded walkthrough of the CRM, listed on the "How to
// Use CRM" page for Admins and Managers. Deliberately NOT a KBArticle with a
// video field: these are onboarding/training material for the tool itself,
// not company knowledge, and they carry a tighter audience (see
// TrainingVideosService's Admin+Manager rule) than the company-wide
// Knowledge Base.
//
// The video file itself lives wherever the poster put it -- Google Drive,
// YouTube, anywhere with a shareable URL. This app deliberately does not host
// or stream the bytes: an earlier version accepted uploads onto a Railway
// volume, which meant capacity planning and permissions for something a Drive
// link solves for free.
model TrainingVideo {
  id          String   @id @default(uuid())
  title       String
  description String?
  // Free-text grouping shown as a section header on the page, e.g.
  // "Getting Started" or "Deals & Pipeline". Null = "General".
  category    String?
  // Shareable link to the recording. Drive and YouTube URLs are turned into
  // an inline player on the page (see toEmbedUrl); anything else opens in a
  // new tab.
  url         String
  // Manual ordering within a category -- lower first, ties broken by
  // createdAt, so a walkthrough series lists in order instead of newest-first.
  position    Int      @default(0)
  uploaderId  String
  uploader    User     @relation("TrainingVideoUploader", fields: [uploaderId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, position])
}

// ─── Telephony (JustCall click-to-call for Sales) ────────────────────────────

// Singleton row holding the company's JustCall API credentials, same
// encrypted-at-rest shape as ApolloConnection/GithubConnection. Only status
// (whether it's connected, who connected it) is ever returned to clients;
// the key/secret stay server-side and are decrypted per-call by
// JustCallProviderService. webhookSecret (if JustCall issues one) verifies
// inbound webhook authenticity -- see JustCallWebhookController.
model JustCallConnection {
  id                 String   @id @default("justcall-connection")
  encryptedApiKey    String
  apiKeyIv           String
  apiKeyAuthTag      String
  encryptedApiSecret String
  apiSecretIv        String
  apiSecretAuthTag   String
  webhookSecret      String?
  connectedById      String?
  connectedBy        User?    @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Singleton row holding the company's CloudTalk API credentials.
// apiAccessKeyId and apiAccessKeySecret are encrypted with APP_ENCRYPTION_KEY.
model CloudTalkConnection {
  id                 String   @id @default("cloudtalk-connection")
  encryptedApiKey    String
  apiKeyIv           String
  apiKeyAuthTag      String
  encryptedApiSecret String
  apiSecretIv        String
  apiSecretAuthTag   String
  webhookSecret      String?
  connectedById      String?
  connectedBy        User?    @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// A business phone number purchased/configured in JustCall and registered
// here so Admin can label it (e.g. "Sales - US") and assign a default per
// department -- the caller ID a lead in that country actually sees, letting
// India-based reps present a local US/Canada presence (see §4 of the plan).
model PhoneNumber {
  id           String      @id @default(uuid())
  provider     String      @default("justcall")
  providerId   String      @unique
  e164         String      @unique
  country      String
  label        String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  smsCapable   Boolean     @default(true)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  @@index([departmentId])
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

enum CallStatus {
  INITIATED
  RINGING
  CONNECTED
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
}

// One row per phone call, independent of Activity -- deliberately NOT reusing
// Activity because Activity.dealId is required, and a call can happen before
// any deal exists (a cold Apollo lead, a bare Contact). When a call IS tied
// to a deal, CallsService also writes a matching Activity(type=CALL) so the
// deal timeline keeps showing it exactly like it does today -- see
// CallsService.logToDealTimeline. providerCallId is the idempotency key the
// webhook handler upserts against, so a redelivered JustCall event can never
// create a duplicate row.
model Call {
  id              String        @id @default(uuid())
  provider        String        @default("justcall")
  providerCallId  String?       @unique
  direction       CallDirection @default(OUTBOUND)
  agentId         String
  agent           User          @relation("CallAgent", fields: [agentId], references: [id])
  contactId       String?
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId          String?
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  // Nullable: the JustCall Dialer SDK's dialNumber() takes only the
  // destination -- the agent's outbound caller-ID line is chosen inside
  // JustCall's own iframe UI, not passed by our code. fromNumber starts null
  // and is filled in once the webhook delivers the real value.
  fromNumber      String?
  toNumber        String
  status          CallStatus    @default(INITIATED)
  durationSec     Int?
  startedAt       DateTime      @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  recordingUrl    String?
  recordingStatus String?
  // Free text, same "teams word dispositions differently" rationale as
  // Activity.outcome -- the frontend offers a suggested list without forcing it.
  disposition     String?
  notes           String?
  nextFollowUpAt  DateTime?
  events          CallEvent[]
  // Set when this call was placed from a power-dialer queue (see
  // CallCampaign) -- lets CallsService.updateDisposition mark the matching
  // CallCampaignLead DONE and auto-advance the queue without a second FK.
  campaignId      String?
  campaign        CallCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([contactId])
  @@index([dealId])
  @@index([agentId, startedAt])
  @@index([status])
  @@index([campaignId])
}

// A power-dialer calling list (§11/§12) -- an ordered set of leads a rep (or
// a team) works through, one call at a time, without manually looking up
// each next number. Deliberately simple for this first pass: a lead is
// either assigned to one agent or left unassigned (any Sales member can
// claim it via CallsService/CallCampaignsService.claimNext) -- round-robin
// auto-distribution is a later refinement, not required to make the queue
// usable today.
model CallCampaign {
  id           String             @id @default(uuid())
  name         String
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creatorId    String
  creator      User               @relation("CallCampaignCreator", fields: [creatorId], references: [id])
  leads        CallCampaignLead[]
  calls        Call[]
  createdAt    DateTime           @default(now())

  @@index([departmentId])
}

enum CallCampaignLeadStatus {
  PENDING
  CALLING
  DONE
}

model CallCampaignLead {
  id           String                 @id @default(uuid())
  campaignId   String
  campaign     CallCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?                  @relation("CallCampaignLeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       CallCampaignLeadStatus @default(PENDING)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([assignedToId, status])
}

// Raw webhook payload audit trail for one Call -- troubleshooting/auditing
// per the plan's §18. providerEventId (when JustCall sends one) is the
// per-event idempotency key, separate from Call.providerCallId which is the
// per-call idempotency key.
model CallEvent {
  id              String   @id @default(uuid())
  callId          String
  call            Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  providerEventId String?  @unique
  eventType       String
  payload         Json
  createdAt       DateTime @default(now())

  @@index([callId])
}

// ─── Recruitment Operating System (ROS) Extensions ──────────────────────────

model CandidateRiskProfile {
  id                    String    @id @default(uuid())
  candidateId           String    @unique
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  offerDeclineRisk      Float     @default(0.0) // 0-100%
  ghostingRisk          Float     @default(0.0)
  counterOfferRisk      Float     @default(0.0)
  joiningFailureRisk    Float     @default(0.0)
  primaryRiskFactor     String?
  recommendedMitigation String?   @db.Text
  updatedAt             DateTime  @updatedAt
}

model TalentPool {
  id           String             @id @default(uuid())
  name         String             @unique // e.g. "Senior React Engineers"
  description  String?
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members      TalentPoolMember[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model TalentPoolMember {
  id          String     @id @default(uuid())
  poolId      String
  pool        TalentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  matchScore  Float      @default(0.0)
  addedAt     DateTime   @default(now())

  @@unique([poolId, candidateId])
}

model RecruiterTaskQueue {
  id            String     @id @default(uuid())
  recruiterId   String
  recruiter     User       @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  candidateId   String?
  candidate     Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  actionType    String // REVIEW, CALL, SCHEDULE, SCORECARD, ESCALATE_OFFER
  priorityScore Float      @default(0.0)
  dueDate       DateTime
  isCompleted   Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([recruiterId, isCompleted, priorityScore])
}

model RecruitmentHealthMetric {
  id                     String   @id @default(uuid())
  calculatedAt           DateTime @default(now())
  globalHealthScore      Float
  pipelineFreshnessScore Float
  offerAcceptanceScore   Float
  joiningSuccessScore    Float
  interviewSlaScore      Float
  hiringVelocityScore    Float
}

// ---------------------------------------------------------------------------
// Scheduled Intent automations: on a schedule, search Intent Hiring and/or
// Intent News, draft a personalised email per decision maker with AI, then
// either queue it for approval or send it from the owner's mailbox.
// ---------------------------------------------------------------------------

enum IntentAutomationSource {
  HIRING
  NEWS
  BOTH
}

enum IntentAutomationFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
}

enum IntentAutomationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum IntentOutreachStatus {
  PENDING_APPROVAL
  SENT
  FAILED
  REJECTED
}

model IntentAutomation {
  id          String                    @id @default(uuid())
  name        String
  isActive    Boolean                   @default(true)
  source      IntentAutomationSource
  // Intent Hiring: one search per role. Intent News: keywords + signal.
  roles       String[]
  location    String?
  newsKeywords String?
  newsCategory String?
  newsDaysBack Int                      @default(30)
  frequency   IntentAutomationFrequency @default(DAILY)
  // "HH:MM" in company time (IST); weekday 0=Sun..6=Sat, WEEKLY only.
  timeOfDay   String                    @default("09:00")
  weekday     Int?
  // false = every draft waits in the approval queue.
  autoSend    Boolean                   @default(false)
  dailyCap    Int                       @default(25)
  cooldownDays Int                      @default(30)
  // What we offer + tone -- the only business context the AI is given.
  offerDescription String
  tone        String                    @default("friendly and professional")
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  createdById String
  createdBy   User                      @relation(fields: [createdById], references: [id])
  runs        IntentAutomationRun[]
  outreach    IntentAutomationOutreach[]
  leads       IntentAutomationLead[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([isActive, nextRunAt])
}

model IntentAutomationRun {
  id           String                    @id @default(uuid())
  automationId String
  automation   IntentAutomation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  trigger      String                    @default("SCHEDULE")
  status       IntentAutomationRunStatus @default(RUNNING)
  startedAt    DateTime                  @default(now())
  finishedAt   DateTime?
  leadsFound   Int                       @default(0)
  queued       Int                       @default(0)
  sent         Int                       @default(0)
  skipped      Int                       @default(0)
  failed       Int                       @default(0)
  error        String?
  outreach     IntentAutomationOutreach[]
  leads        IntentAutomationLead[]

  @@index([automationId, startedAt])
}

model IntentAutomationOutreach {
  id           String               @id @default(uuid())
  automationId String
  automation   IntentAutomation     @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runId        String?
  run          IntentAutomationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  companyName  String
  companyDomain String?
  contactName  String
  contactTitle String?
  contactEmail String
  contactId    String?
  // "HIRING" | "NEWS"
  signalType   String
  signalTitle  String
  signalUrl    String?
  subject      String
  body         String
  status       IntentOutreachStatus @default(PENDING_APPROVAL)
  error        String?
  sentAt       DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())

  @@index([automationId, createdAt])
  @@index([contactEmail, createdAt])
  @@index([status])
}

enum IntentLeadOutcome {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

// Everything an automation run found, kept whether or not an email resulted --
// so the search data isn't lost when a lead is skipped (no email, recently
// contacted, daily cap reached, ...).
model IntentAutomationLead {
  id             String             @id @default(uuid())
  automationId   String
  automation     IntentAutomation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runId          String
  run            IntentAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyName    String
  companyDomain  String?
  companyLocation String?
  // "HIRING" | "NEWS"
  signalType     String
  signalTitle    String
  signalUrl      String?
  signalDetail   String?
  signalDate     DateTime?
  contactName    String?
  contactTitle   String?
  contactEmail   String?
  contactLinkedin String?
  outcome        IntentLeadOutcome
  // NO_EMAIL, DUPLICATE_IN_RUN, SUPPRESSED, RECENTLY_CONTACTED, DAILY_CAP_REACHED,
  // DRAFT_FAILED, AI_NOT_CONFIGURED
  skipReason     String?
  outreachId     String?
  createdAt      DateTime           @default(now())

  @@index([automationId, createdAt])
  @@index([runId])
}

// ---------------------------------------------------------------------------
// AI assistant: per-user conversations. Messages keep the raw Anthropic content
// blocks (text / tool_use / tool_result) so a conversation can be replayed to
// the model. Actions that change data wait here until the user confirms them.
// ---------------------------------------------------------------------------

enum AssistantActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

model AssistantConversation {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]
  actions   AssistantAction[]

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id             String                @id @default(uuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // "user" | "assistant"
  role           String
  // "chat" (typed by the user / written by the model) or "note" (a system note
  // about a confirmed or cancelled action -- sent to the model, hidden in the UI).
  kind           String                @default("chat")
  content        Json
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

model AssistantAction {
  id             String                @id @default(uuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  toolName       String
  input          Json
  summary        String
  status         AssistantActionStatus @default(PENDING)
  result         Json?
  error          String?
  createdAt      DateTime              @default(now())
  decidedAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([userId, status])
}

// ─── LINKEDIN INTEGRATION ───────────────────────────────────────────────

enum LinkedInConnectionStatus {
  CONNECTED
  DISCONNECTED
  CHECKPOINT_REQUIRED
  RATE_LIMITED
  EXPIRED
}

enum LinkedInActionType {
  PROFILE_VIEW
  CONNECTION_REQUEST
  DIRECT_MESSAGE
  INMAIL
}

enum LinkedInActionStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  ACCEPTED
  REPLIED
}

model UserLinkedInConnection {
  id                 String                   @id @default(uuid())
  userId             String                   @unique
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountEmail       String
  accountName        String?
  profileUrn         String?
  profileUrl         String?
  profilePicUrl      String?
  accessToken        String?
  status             LinkedInConnectionStatus @default(CONNECTED)
  dailyInviteLimit   Int                      @default(20)
  dailyMessageLimit  Int                      @default(50)
  invitesSentToday   Int                      @default(0)
  messagesSentToday  Int                      @default(0)
  lastResetDate      String                   @default("")
  lastSyncAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  actions            LinkedInAction[]
  messages           LinkedInMessage[]
}

model LinkedInAction {
  id             String                 @id @default(uuid())
  connectionId   String
  connection     UserLinkedInConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contactId      String?
  candidateId    String?
  leadId         String?
  actionType     LinkedInActionType
  targetUrl      String
  messageBody    String?
  status         LinkedInActionStatus   @default(QUEUED)
  scheduledFor   DateTime               @default(now())
  executedAt     DateTime?
  errorMessage   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([connectionId, status, scheduledFor])
}

model LinkedInMessage {
  id             String                 @id @default(uuid())
  connectionId   String
  connection     UserLinkedInConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversationId String
  senderUrn      String
  senderName     String
  senderPicUrl   String?
  recipientUrn   String
  content        String
  sentAt         DateTime
  isOutbound     Boolean
  read           Boolean                @default(false)
  contactId      String?
  candidateId    String?
  createdAt      DateTime               @default(now())

  @@index([connectionId, conversationId])
  @@index([contactId])
}

enum IntentSignalTier {
  ERP_AI_VIP
  ENTERPRISE_HIGH
  STANDARD_GROWTH
}

model ScrapedIntentArticle {
  id               String            @id @default(uuid())
  title            String
  url              String            @unique
  domain           String
  publishedAt      DateTime?
  rawContent       String?           @db.Text
  keySnippet       String?           @db.Text
  // ERP_AI | FUNDING | EXPANSION | HIRING | OTHER, set by the AI analysis.
  signalType       String?

  tier             IntentSignalTier  @default(STANDARD_GROWTH)
  isErpAiPriority  Boolean           @default(false)
  intentScore      Int               @default(70)
  erpVendors       String[]          @default([])
  aiKeywords       String[]          @default([])
  targetedRoles    String[]          @default([])
  companyName      String?
  companyDomain    String?

  companyId        String?
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  discoveredById   String?
  discoveredBy     User?             @relation("UserScrapedIntentNews", fields: [discoveredById], references: [id], onDelete: SetNull)

  status           String            @default("NEW")
  // EXTENSION (scraped in a browser) | CRAWLER (server-side open-source crawl)
  origin           String            @default("EXTENSION")
  decisionMaker    Json?
  aiDraftedEmail   String?           @db.Text

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([origin, publishedAt])
  @@index([tier])
  @@index([isErpAiPriority])
  @@index([companyId])
  @@index([discoveredById])
}


enum SignOutRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// A locked-in user (User.canSignOut = false) asks an Admin to let them sign
// out. Rows are kept as an audit log; approving one ends all of the user's
// sessions (web + desktop agent).
model SignOutRequest {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation("SignOutRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  status      SignOutRequestStatus @default(PENDING)
  reason      String?
  decidedById String?
  decidedBy   User?                @relation("SignOutRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  decidedAt   DateTime?
  // Set once the requester's client has acted on the decision, so an old
  // approval can't sign them out again after they log back in.
  ackedAt     DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum AttendanceAdjustmentStatus {
  PENDING
  APPROVED
  DENIED
}

// A person asks an Admin to record a day they did not clock in, copying the
// hours of their most recent real session. Another Admin must approve; the
// resulting WorkSession is flagged via adjustmentRequestId and rows are kept as
// an audit log.
model AttendanceAdjustmentRequest {
  id          String                     @id @default(uuid())
  userId      String
  user        User                       @relation("AdjustmentRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  forDate     DateTime
  reason      String
  status      AttendanceAdjustmentStatus @default(PENDING)
  decidedById String?
  decidedBy   User?                      @relation("AdjustmentRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime                   @default(now())

  @@index([status, createdAt])
  @@index([userId, forDate])
}

// "I'll start late today": asked ahead of the shift, approved or denied by the
// owner. An approved one auto-excuses a late clock-in within expectedLateMin;
// the session stays on record, flagged, and no footage is ever added.
model LateStartRequest {
  id              String                     @id @default(uuid())
  userId          String
  user            User                       @relation("LateStartRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  // Work day ("YYYY-MM-DD" in the policy timezone) the late start is for.
  forDay          String
  expectedLateMin Int
  status          AttendanceAdjustmentStatus @default(PENDING)
  decidedById     String?
  decidedBy       User?                      @relation("LateStartRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  createdAt       DateTime                   @default(now())

  @@index([status, createdAt])
  @@index([userId, forDay])
}

// =========================================================================
// AI TOKEN USAGE & REAL-TIME COST MONITORING
// =========================================================================

model AiTokenUsage {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider         String   // "GEMINI", "OPENAI", "ANTHROPIC", "GROK"
  model            String   // e.g. "gemini-flash-latest", "gpt-4o-mini", "claude-3-5-sonnet-latest"
  feature          String   // "AI_ASSISTANT", "INTENT_OUTREACH", "FOLLOW_UP", "SEO_BRIEF", "GROWTH_NEWS"
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float    @default(0.0)
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([provider])
  @@index([feature])
}

// Public ERP / financial-system tenders pulled from open government feeds
// (CanadaBuys, SAM.gov). A tender is a buyer with a budget and a deadline,
// so unlike scraped page text it is real buying intent.
model ErpTender {
  id            String    @id @default(uuid())
  source        String // "CANADABUYS" | "SAM_GOV"
  externalId    String
  country       String // "CA" | "US"
  title         String
  description   String?   @db.Text
  buyerName     String?
  buyerRegion   String?
  publishedAt   DateTime?
  closesAt      DateTime?
  noticeUrl     String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  matchedTerms  String[]  @default([])
  isOpen        Boolean   @default(true)
  // NEW | REVIEWING | PURSUING | DISMISSED
  status        String    @default("NEW")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([closesAt])
  @@index([status])
  @@index([country])
}

// Companies showing, through their own job postings, that they are choosing,
// replacing or implementing an ERP -- direct buyers, no tender involved.
model ErpBuyerSignal {
  id           String    @id @default(uuid())
  source       String // "ADZUNA_JOBS"
  externalId   String
  country      String // "US" | "CA"
  companyName  String
  jobTitle     String
  location     String?
  description  String?   @db.Text
  postedAt     DateTime?
  url          String?
  // SELECTING (evaluating/replacing -> shopping now) | IMPLEMENTING (vendor already chosen)
  stage        String
  matchedTerms String[]  @default([])
  // NEW | REVIEWING | PURSUING | DISMISSED
  status       String    @default("NEW")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([companyName])
  @@index([stage])
  @@index([postedAt])
}
